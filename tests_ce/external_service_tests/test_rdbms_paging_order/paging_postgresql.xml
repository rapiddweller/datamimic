<!-- Paged RDBMS reads must follow a unique total order (#228): pageSize="5" splits the 12 rows
     into 3 OFFSET pages (distribution="ordered" keeps the read order visible). Rows were inserted out of order, so a page read without a stable
     ORDER BY returns physical/tie order and the assertions in test_rdbms_paging_order.py fail. -->
<setup>
    <database id="sourceDB" system="postgresql" />
    <execute uri="script/setup_postgresql.scr.sql" target="sourceDB" />

    <!-- no primary key, non-unique first column: ordered by the full column list -->
    <generate name="by_type" source="sourceDB" distribution="ordered" type="page_rows" pageSize="5" target="" />
    <!-- primary key is not the first column: ordered by the primary key -->
    <generate name="by_type_pk" source="sourceDB" distribution="ordered" type="page_rows_pk" pageSize="5" target="" />
    <!-- arbitrary selector: ordered by every output column -->
    <generate name="by_selector" source="sourceDB" distribution="ordered" selector="SELECT grp, id FROM functional.page_rows"
              pageSize="5" target="" />
    <!-- two workers, three pages each: no row read twice, none skipped -->
    <generate name="by_type_mp" source="sourceDB" distribution="ordered" type="page_rows" pageSize="3" numProcess="2" target="" />
    <generate name="by_selector_mp" source="sourceDB" distribution="ordered" selector="SELECT grp, id FROM functional.page_rows"
              pageSize="3" numProcess="2" target="" />
    <!-- the selector's own ORDER BY is its source order and must survive paging -->
    <generate name="by_selector_desc" source="sourceDB" distribution="ordered"
              selector="SELECT grp, id FROM functional.page_rows ORDER BY id DESC" pageSize="5" target="" />
    <!-- default distribution: every worker shuffles the full unpaged read, so it must arrive in one order -->
    <generate name="by_type_random_mp" source="sourceDB" type="page_rows" pageSize="3" numProcess="2" target="" />
    <!-- own ORDER BY on a non-unique column: ties must still page deterministically -->
    <generate name="by_selector_grp" source="sourceDB" distribution="ordered"
              selector="SELECT grp, id FROM functional.page_rows ORDER BY grp" pageSize="5" target="" />
    <generate name="by_selector_grp_mp" source="sourceDB" distribution="ordered"
              selector="SELECT grp, id FROM functional.page_rows ORDER BY grp" pageSize="3" numProcess="2" target="" />
    <!-- own row limit: a bounded result, ordered deterministically inside its limit and paged in its own order -->
    <generate name="by_selector_bounded" source="sourceDB" distribution="ordered"
              selector="SELECT grp, id FROM functional.page_rows ORDER BY grp DESC LIMIT 7" pageSize="3" target="" />
</setup>
