<!-- Uneven count/numProcess ratio: count=13 does not divide evenly across numProcess=4
     (13 = 4+4+4+1 chunks). A non-atomic advance-by-N or an off-by-one in the per-process
     range arithmetic (SequenceTableGenerator.__init__: process_offset = process_id *
     per_process_count) is exactly the kind of bug an evenly-divisible count would hide. -->
<setup numProcess="4">

    <database id="sourceDB" system="postgresql" />

    <include uri="conf/base.properties" />

    <execute uri="script/setup_postgresql.scr.sql" target="sourceDB" />

    <generate name="seq-gen" type="sequence_table_generator" count="13" target="sourceDB" numProcess="4">
        <key name="id" database="sourceDB" generator="SequenceTableGenerator" />
        <key name="name" type="string" />
    </generate>

    <generate name="check" type="sequence_table_generator" source="sourceDB" count="13"
        target="ConsoleExporter"
    />
</setup>
