{
  "version": "5.0",
  "environment_bindings": [
    {"environment": "mongodb", "family": "mongodb"},
    {"environment": "warehouse", "family": "database"}
  ],
  "product_roles": [
    {"product": "dm_x6_raw_orders", "field": "order_id", "role": {"kind": "identifier"}},
    {"product": "orders", "field": "order_id", "role": {"kind": "identifier"}},
    {"product": "orders_back", "field": "order_id", "role": {"kind": "identifier"}}
  ],
  "expectations": [
    {"kind": "exact_count", "subject": {"kind": "product", "product": "dm_x6_raw_orders"}, "count": 12},
    {"kind": "unique", "subject": {"kind": "product", "product": "dm_x6_raw_orders"}, "field": "order_id"},
    {"kind": "range", "subject": {"kind": "product", "product": "dm_x6_raw_orders"}, "field": "cents", "minimum": 100, "maximum": 9999999},
    {"kind": "exact_count", "subject": {"kind": "product", "product": "orders"}, "count": 12},
    {"kind": "unique", "subject": {"kind": "product", "product": "orders"}, "field": "order_id"},
    {"kind": "allowed_values", "subject": {"kind": "product", "product": "orders"}, "field": "status", "values": ["new", "paid", "shipped"]},
    {"kind": "range", "subject": {"kind": "product", "product": "orders"}, "field": "amount_cents", "minimum": 100, "maximum": 9999999},
    {"kind": "exact_count", "subject": {"kind": "product", "product": "orders_back"}, "count": 12},
    {"kind": "unique", "subject": {"kind": "product", "product": "orders_back"}, "field": "order_id"},
    {"kind": "allowed_values", "subject": {"kind": "product", "product": "orders_back"}, "field": "status", "values": ["new", "paid", "shipped"]},
    {"kind": "range", "subject": {"kind": "product", "product": "orders_back"}, "field": "amount_cents", "minimum": 100, "maximum": 9999999}
  ]
}
