<setup>
    <!-- Purpose: make the orders and write them to the orders collection. -->
    <generate name="dm_s51_orders" count="12" target="mongodb">
        <key name="id" generator="IncrementGenerator"/>
        <key name="status" values="('new', 'paid', 'shipped')"/>
        <key name="amount_cents" type="int" min="100" max="9900"/>
    </generate>
</setup>
