<setup>
    <database id="sourceDB" system="postgresql"/>
    <execute type="sql" target="sourceDB">
        CREATE TABLE IF NOT EXISTS dm_clear_items (id INTEGER PRIMARY KEY, name TEXT);
    </execute>
    <!-- Cleanup, then load: every run ends with the same three rows. -->
    <generate name="clear_items" targetEntity="dm_clear_items" target="sourceDB.clear"/>
    <generate name="dm_clear_items" count="3" target="sourceDB">
        <key name="id" generator="IncrementGenerator"/>
        <key name="name" script="'n' + str(this.id)"/>
    </generate>
    <generate name="items_left" source="sourceDB" selector="SELECT id, name FROM dm_clear_items ORDER BY id" distribution="ordered" target=""/>
</setup>
