<setup>
    <generate name="cumulated_generator" target="ConsoleExporter" count="200">
        <key name="number_of_items" generator="IntegerGenerator(min=1, max=27, distribution=NumberDistribution.CUMULATED)"/>
        <key name="price" generator="FloatGenerator(min=0.49, max=99.99, granularity=0.10, distribution=NumberDistribution.CUMULATED)"/>
    </generate>
</setup>
