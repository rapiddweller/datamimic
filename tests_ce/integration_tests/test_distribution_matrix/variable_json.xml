<setup rngSeed="42" defaultSeparator=",">
    <!-- <variable source=JSON> × {ordered, random, cumulated}. rows.json holds v = 0..26. -->
    <generate name="ordered" count="27" target="">
        <variable name="row" source="rows.json" distribution="ordered"/>
        <key name="v" script="row.v"/>
    </generate>
    <generate name="random" count="27" target="">
        <variable name="row" source="rows.json" distribution="random"/>
        <key name="v" script="row.v"/>
    </generate>
    <generate name="cumulated" count="6000" target="">
        <variable name="row" source="rows.json" distribution="cumulated"/>
        <key name="v" script="row.v"/>
    </generate>
</setup>
