<setup rngSeed="42" defaultSeparator=",">
    <!-- <variable source=DB selector> × {ordered, random, cumulated}. Table holds v = 0..26. -->
    <database id="itemsdb" database="matrix_items_db" dbms="sqlite"/>
    <execute uri="script/setup_items.scr.sql" target="itemsdb"/>
    <generate name="ordered" count="27" target="">
        <variable name="row" source="itemsdb" selector="SELECT v FROM cumulated_items" distribution="ordered"/>
        <key name="v" script="row.v"/>
    </generate>
    <generate name="random" count="27" target="">
        <variable name="row" source="itemsdb" selector="SELECT v FROM cumulated_items" distribution="random"/>
        <key name="v" script="row.v"/>
    </generate>
    <generate name="cumulated" count="6000" target="">
        <variable name="row" source="itemsdb" selector="SELECT v FROM cumulated_items" distribution="cumulated"/>
        <key name="v" script="row.v"/>
    </generate>
</setup>
