<setup rngSeed="42" defaultSeparator=",">
    <!-- <variable source=memstore type> × {ordered, random, cumulated}.
         IncrementGenerator seeds v = 1..27 into the memstore (base offset 1, not 0). -->
    <memstore id="mem"/>
    <generate name="rows" count="27" target="mem">
        <key name="v" type="int" generator="IncrementGenerator"/>
    </generate>
    <generate name="ordered" count="27" target="">
        <variable name="row" source="mem" type="rows" distribution="ordered"/>
        <key name="v" script="row.v"/>
    </generate>
    <generate name="random" count="27" target="">
        <variable name="row" source="mem" type="rows" distribution="random"/>
        <key name="v" script="row.v"/>
    </generate>
    <generate name="cumulated" count="6000" target="">
        <variable name="row" source="mem" type="rows" distribution="cumulated"/>
        <key name="v" script="row.v"/>
    </generate>
</setup>
