<setup>
    <!-- step over 1..3 has exactly 3 values; count=5 must cap at 3 rows (legacy-DSL: the
         sequence ends, it never wraps or repeats) -->
    <generate name="rows" count="5" target="ConsoleExporter">
        <key name="v" type="int" min="1" max="3" distribution="step"/>
    </generate>
</setup>
