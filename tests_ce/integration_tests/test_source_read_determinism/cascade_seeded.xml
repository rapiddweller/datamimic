<setup rngSeed="42" defaultSeparator=",">
    <!-- Cascading seeded: outer <generate> contains a <nestedKey> that reads
         data/people.ent.csv with distribution="random".  With <setup rngSeed>
         both the outer iteration order and the inner shuffle are derived from
         the root RNG, so the full nested structure replays identically. -->
    <generate name="outer" count="3" target="">
        <key name="oid" generator="IncrementGenerator" />
        <nestedKey name="children" type="list" count="4"
                   source="data/people.ent.csv" distribution="random">
        </nestedKey>
    </generate>
</setup>
