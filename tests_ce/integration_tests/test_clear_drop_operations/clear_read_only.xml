<setup>
    <database id="db" database="clear_ops_readonly" dbms="sqlite"/>
    <database id="reader" database="clear_ops_readonly" dbms="sqlite" readOnly="true"/>
    <execute type="sql" target="db">
        DROP TABLE IF EXISTS items;
        CREATE TABLE items (id INTEGER PRIMARY KEY);
        INSERT INTO items VALUES (1);
    </execute>
    <!-- A read-only client refuses to clear. -->
    <generate name="clear_items" targetEntity="items" target="reader.clear"/>
</setup>
