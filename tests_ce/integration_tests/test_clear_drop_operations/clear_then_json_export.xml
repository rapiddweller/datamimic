<setup>
    <database id="db" database="clear_ops_export" dbms="sqlite"/>
    <execute type="sql" target="db">
        DROP TABLE IF EXISTS items;
        CREATE TABLE items (id INTEGER PRIMARY KEY);
        INSERT INTO items VALUES (1);
    </execute>
    <!-- A clear before the first export must not disturb the buffered file export that follows. -->
    <generate name="clear_items" targetEntity="items" target="db.clear"/>
    <generate name="exported" count="3" exportUri="clear_export_out" target="JSON">
        <key name="id" generator="IncrementGenerator"/>
    </generate>
</setup>
