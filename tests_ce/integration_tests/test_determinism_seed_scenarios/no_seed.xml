<setup>
    <!-- Scenario 3: no seed anywhere. No <setup rngSeed> and no per-variable rngSeed,
         so each entity seeds itself from the wall clock. Two runs must DIFFER. -->
    <generate name="people" count="5" target="">
        <variable name="p" entity="Person" dataset="US"/>
        <key name="given_name" script="p.given_name"/>
        <key name="family_name" script="p.family_name"/>
        <key name="birthdate" script="p.birthdate"/>
    </generate>
</setup>
