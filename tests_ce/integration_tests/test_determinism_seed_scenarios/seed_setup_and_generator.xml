<setup seed="42">
    <!-- Scenario 2: seed at setup level AND at the generator (variable) level.
         The 'overridden' block carries its own rngSeed, which must WIN over the
         <setup seed>; the 'derived' block has no own seed and must follow the
         setup seed. The test proves this by re-running with a different setup
         seed: 'overridden' stays identical, 'derived' changes. -->
    <generate name="overridden" count="4" target="">
        <variable name="p" entity="Person" dataset="US" rngSeed="99"/>
        <key name="given_name" script="p.given_name"/>
        <key name="family_name" script="p.family_name"/>
    </generate>
    <generate name="derived" count="4" target="">
        <variable name="q" entity="Person" dataset="US"/>
        <key name="given_name" script="q.given_name"/>
        <key name="family_name" script="q.family_name"/>
    </generate>
</setup>
