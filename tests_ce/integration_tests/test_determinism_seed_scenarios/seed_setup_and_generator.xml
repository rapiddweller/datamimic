<setup>
    <!-- Scenario 2: seed in setup AND in the generator (variable).
         The 'overridden' block carries its own rngSeed, which must WIN over the
         setup (demographics) seed; the 'derived' block has no own seed and must
         follow the setup seed. The test proves this by re-running with a different
         demographics seed: 'overridden' stays identical, 'derived' changes. -->
    <demographics dataset="DE" version="2023Q4" dir="DE/2023Q4" rngSeed="42"/>
    <generate name="overridden" count="3" target="">
        <variable name="p" entity="Patient" dataset="DE" rngSeed="99"/>
        <key name="ssn" script="p.ssn"/>
        <key name="record" script="p.medical_record_number"/>
    </generate>
    <generate name="derived" count="3" target="">
        <variable name="q" entity="Patient" dataset="DE"/>
        <key name="ssn" script="q.ssn"/>
        <key name="record" script="q.medical_record_number"/>
    </generate>
</setup>
