<setup seed="42">
    <!-- Scenario 1: seed at setup level only.
         <setup seed> makes the whole model deterministic: every variable without
         its own rngSeed derives a reproducible child RNG from this root.
         Two runs must be byte-identical. -->
    <generate name="people" count="4" target="">
        <variable name="p" entity="Person" dataset="US"/>
        <key name="given_name" script="p.given_name"/>
        <key name="family_name" script="p.family_name"/>
    </generate>
    <generate name="addresses" count="3" target="">
        <variable name="a" entity="Address" dataset="US"/>
        <key name="street" script="a.street"/>
        <key name="city" script="a.city"/>
    </generate>
</setup>
