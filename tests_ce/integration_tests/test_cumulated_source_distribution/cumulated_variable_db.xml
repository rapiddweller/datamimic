<setup rngSeed="42">
    <!-- The real corpus shape: <variable source=DB selector distribution="cumulated">.
         Mirrors shop-mongodb.ben.xml's <variable name="product" source="db" distribution="cumulated"
         selector="find: ...">. Rows are picked with a bell-weighted index over the load order
         (with replacement); <setup rngSeed> makes the selection reproducible. -->
    <database id="itemsdb" database="cumulated_items_db" dbms="sqlite"/>
    <execute uri="script/setup_cumulated_items.scr.sql" target="itemsdb"/>
    <generate name="picks" count="6000" target="">
        <variable name="row" source="itemsdb" selector="SELECT v FROM cumulated_items" distribution="cumulated"/>
        <key name="v" script="row.v"/>
    </generate>
</setup>
