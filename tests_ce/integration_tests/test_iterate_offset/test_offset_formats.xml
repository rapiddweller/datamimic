<setup defaultSeparator=",">
    <!-- one iterate per file format: every loader's offset pass-through, same 5-row fixture -->
    <iterate name="rows_json" source="data/rows.json" offset="2" distribution="ordered" target="ConsoleExporter"/>
    <!-- xml derives its count from the <item> list like every other format (no count= here) -->
    <iterate name="rows_xml" source="data/rows.xml" offset="2" distribution="ordered" target="ConsoleExporter"/>
    <iterate name="rows_fcw" source="data/rows.fcw" offset="2" distribution="ordered" target="ConsoleExporter"/>
    <iterate name="rows_xlsx" source="data/rows.xlsx" offset="2" distribution="ordered" target="ConsoleExporter"/>
    <!-- dbunit needs an explicit count: without sourceEntity the table defaults to the iterate name -->
    <iterate name="rows_dbunit" source="data/rows.dbunit.xml" offset="2" count="3" distribution="ordered" target="ConsoleExporter"/>
</setup>
