<setup rngSeed="13">
    <!-- inline weighted value pick on <variable>: 'weights' is the companion of 'values'.
         Weights are relative (need not sum to 1). Seed-bound via ctx.rng.
         The variable is referenced via a <key script> to surface the value in the output. -->
    <generate name="people" count="600" target="">
        <variable name="grade" values="'A','B','C'" weights="0.1, 0.3, 0.6"/>
        <key name="grade" script="grade"/>
    </generate>
</setup>
