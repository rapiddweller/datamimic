<setup>
    <!-- No rngSeed: a random key per run, so the same value gives the same token within a run only. -->
    <generate name="hashed" count="10" target="">
        <key name="email" constant="max.mustermann@example.com"/>
        <key name="token" script="email" converter="Hash('sha256','hex')"/>
        <key name="token_again" script="email" converter="Hash('sha256','hex')"/>
        <key name="token_base64" script="email" converter="Hash('sha256','base64')"/>
    </generate>
</setup>
