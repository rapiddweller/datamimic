<setup>
    <!-- 24h sinusoidal seasonality computed purely from ts.now.hour.
         Mathematical, deterministic by construction. Mid-day should be > midnight. -->
    <generate name="rows"
              from="2026-01-01T00:00:00+00:00"
              to="2026-01-02T00:00:00+00:00"
              interval="PT1H"
              target="">
        <key name="timestamp" script="ts.now.isoformat()"/>
        <key name="hour"      script="ts.now.hour"/>
        <key name="value"     script="20 - 10 * math.cos(ts.now.hour * math.pi / 12)"/>
    </generate>
</setup>
