<setup>
    <!-- 1 day window. Used as the "short" half of the prefix-stability test:
         the rows from this run must match the first 24 rows of window_long.xml. -->
    <generate name="rows"
              start="2026-01-01T00:00:00+00:00"
              end="2026-01-02T00:00:00+00:00"
              interval="PT1H"
              target="">
        <key name="timestamp" script="ts.now.isoformat()"/>
        <key name="step"      script="ts.step"/>
    </generate>
</setup>
