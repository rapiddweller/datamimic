<setup>
    <!-- PT0.0000000001S = 0.1 ns. Sub-microsecond -> not representable in
         datetime.timedelta -> must error with a clear message. -->
    <generate name="rows"
              from="2026-01-01T00:00:00+00:00"
              to="2026-01-01T00:00:01+00:00"
              interval="PT0.0000000001S"
              target="">
        <key name="timestamp" script="ts.now.isoformat()"/>
    </generate>
</setup>
