<setup>
    <!-- A single time series: count is omitted (defaults to 1 series).
         24 ticks at 1h intervals over one day. Pure functions of ts.now/ts.step
         are deterministic by construction.
         Note: output column is named "timestamp" because a key named "ts"
         would shadow the namespace (see datamimic_ce/utils/timeseries.py). -->
    <generate name="rows"
              start="2026-01-01T00:00:00+00:00"
              end="2026-01-02T00:00:00+00:00"
              interval="PT1H"
              target="">
        <key name="timestamp" script="ts.now.isoformat()"/>
        <key name="step"      script="ts.step"/>
        <key name="series"    script="ts.series"/>
        <key name="hour"      script="ts.now.hour"/>
    </generate>
</setup>
