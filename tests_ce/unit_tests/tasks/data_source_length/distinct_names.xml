<!-- Control: distinct names, so each read has its own cache key. -->
<setup rngSeed="1">
    <memstore id="mem"/>
    <generate name="a" count="2" target="mem"><key name="id" generator="IncrementGenerator"/></generate>
    <generate name="rd_a" source="mem" sourceEntity="a" distribution="ordered"><key name="id" script="this.id"/></generate>
    <generate name="b" count="5" target="mem"><key name="id" generator="IncrementGenerator"/></generate>
    <generate name="rd_b" source="mem" sourceEntity="b" distribution="ordered"><key name="id" script="this.id"/></generate>
</setup>
