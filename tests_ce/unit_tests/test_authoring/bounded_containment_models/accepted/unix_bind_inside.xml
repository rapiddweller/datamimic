<!-- Accepted: an AF_UNIX socket bound below the private root stays quiet. (also passes before #363: it guards the fix against over-refusing) -->
<setup rngSeed="7">
    <generate name="rows" count="1" target="">
        <key name="value" script="requests.packages.urllib3.util.connection.socket.socket(requests.packages.urllib3.util.connection.socket.AF_UNIX).bind('s.sock') or 1"/>
    </generate>
</setup>
