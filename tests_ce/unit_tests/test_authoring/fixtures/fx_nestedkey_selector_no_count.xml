<setup rngSeed="1">
    <generate name="orders" count="5" target="ConsoleExporter">
        <key name="id" generator="IncrementGenerator"/>
        <nestedKey name="items" source="items.csv" selector="active=true">
            <key name="sku" pattern="[A-Z]{3}"/>
        </nestedKey>
    </generate>
</setup>
