<setup defaultSeparator="," rngSeed="42">
    <generate name="departments" source="fx_dynamic_child_count.departments.csv" distribution="ordered">
        <key name="dept_id" script="dept_id"/>
        <key name="headcount" script="headcount"/>
        <!-- dept_name is text: the count fails with a ValueError, not a scope error -->
        <generate name="employees" count="{int(dept_id) + int(dept_name)}">
            <key name="employee_id" generator="GlobalIncrementGenerator"/>
            <key name="dept_id" script="parent.dept_id"/>
        </generate>
    </generate>
</setup>
