<setup rngSeed="1">
    <database id="db" database="conf_db" dbms="sqlite"/>
    <execute type="sql" target="db">
        DROP TABLE IF EXISTS items;
        CREATE TABLE items (id INTEGER PRIMARY KEY);
        INSERT INTO items VALUES (1);
        INSERT INTO items VALUES (2);
    </execute>
    <generate name="clear_items" targetEntity="items" target="db.clear"/>
    <generate name="new_items" count="3" targetEntity="items" target="db">
        <key name="id" generator="IncrementGenerator"/>
    </generate>
    <generate name="items_left" source="db" selector="SELECT id FROM items" distribution="ordered" target=""/>
</setup>
