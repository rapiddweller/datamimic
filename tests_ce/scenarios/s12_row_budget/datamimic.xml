<setup rngSeed="12">
    <generate name="customers" count="5">
        <key name="customer_id" generator="IncrementGenerator"/>
    </generate>
    <generate name="products" count="8">
        <key name="product_id" generator="IncrementGenerator"/>
        <key name="price_cents" type="int" min="100" max="9900"/>
    </generate>
    <generate name="orders" count="12">
        <key name="order_id" generator="IncrementGenerator"/>
        <key name="customer_id" type="int" min="1" max="5"/>
    </generate>
</setup>
