<setup rngSeed="5">
    <generate name="accounts" count="5">
        <key name="account_id" constant="1"/>
        <key name="tier" values="('basic', 'plus')"/>
    </generate>
    <generate name="payments" count="8">
        <key name="payment_id" generator="IncrementGenerator"/>
        <key name="account_id" type="int" min="1" max="5"/>
        <key name="amount" type="int" min="1" max="1000"/>
    </generate>
</setup>
