    {"kind": "allowed_values", "subject": {"kind": "product", "product": "accounts"}, "field": "tier", "values": ["basic", "plus"]},
    {"kind": "range", "subject": {"kind": "product", "product": "payments"}, "field": "amount", "minimum": 1, "maximum": 1000}
