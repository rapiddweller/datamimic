<setup rngSeed="24">
    <!-- An entity file: pipe-separated, a header row, UTF-8. The default separator is the pipe. -->
    <generate name="people" count="3">
        <variable name="row" source="data/entity/people.ent.csv" distribution="ordered"/>
        <!-- A CSV column arrives as text: cast it for numbers. -->
        <key name="person_id" script="int(row.person_id)"/>
        <key name="name" script="row.name"/>
        <key name="age" script="int(row.age)"/>
        <!-- A headerless weighted file, value|weight: both forms draw by weight. -->
        <key name="function" source="data/weighting/functions.wgt.csv"/>
        <variable name="other" source="data/weighting/functions.wgt.csv"/>
        <key name="second_function" script="other"/>
        <!-- A weighted entity file has a header and a weight column; a variable draws one row by weight. -->
        <variable name="tier_row" source="data/weighting/tiers.wgt.ent.csv"/>
        <key name="tier" script="tier_row.tier"/>
        <key name="discount" script="int(tier_row.discount)"/>
    </generate>
    <!-- A generate source copies every column of every row, as text, in file order. -->
    <generate name="copies" source="data/entity/people.ent.csv" distribution="ordered"/>
    <!-- The rule-catalog file forms: a cyclic variable wraps after the last row, a row variable takes type=,
         and a cyclic list nestedKey with a count reads rows; a nestedKey reads a CSV file only in list mode. -->
    <generate name="catalog_forms" count="4">
        <variable name="cycled" source="data/entity/people.ent.csv" distribution="ordered" cyclic="true"/>
        <key name="cycled_id" script="int(cycled.person_id)"/>
        <variable name="typed_row" source="data/entity/people.ent.csv" type="row" distribution="ordered" cyclic="true"/>
        <key name="typed_name" script="typed_row.name"/>
        <nestedKey name="team" type="list" source="data/entity/people.ent.csv" cyclic="true" count="2"/>
    </generate>
</setup>
