    {"name": "datetime_bounds_are_applied", "diagnostic": "row_condition",
     "patch": {"file": "datamimic.xml", "old": "max=\"2026-01-31 23:59:59\"", "new": "max=\"2026-03-31 23:59:59\""}},
    {"name": "min_above_max_is_refused_as_in_the_call_form", "diagnostic": "child_execution", "issue": "I832",
     "patch": {"file": "datamimic.xml", "old": "min=\"18\" max=\"65\"", "new": "min=\"66\" max=\"65\""}},
    {"name": "argument_the_generator_does_not_take", "diagnostic": "child_execution", "issue": "I438",
