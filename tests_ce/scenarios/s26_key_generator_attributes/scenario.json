    {"name": "call_and_attribute_set_different_arguments", "diagnostic": "child_execution", "issue": "I439",
     "patch": {"file": "datamimic.xml", "old": "generator=\"IntegerGenerator\" min=\"18\" max=\"65\"", "new": "generator=\"IntegerGenerator(min=18)\" max=\"65\""}},
    {"name": "call_and_attribute_set_the_same_argument", "diagnostic": "child_execution", "issue": "I439",
     "patch": {"file": "datamimic.xml", "old": "generator=\"IntegerGenerator\" max=\"3\"", "new": "generator=\"IntegerGenerator(max=3)\" max=\"3\""}},
    {"name": "empty_call_with_attributes", "diagnostic": "child_execution", "issue": "I439",
     "patch": {"file": "datamimic.xml", "old": "generator=\"IntegerGenerator\" min=\"18\" max=\"65\"", "new": "generator=\"IntegerGenerator()\" min=\"18\" max=\"65\""}},
    {"name": "bound_is_not_a_literal", "diagnostic": "child_execution", "issue": "I436",
     "patch": {"file": "datamimic.xml", "old": "min=\"18\"", "new": "min=\"eighteen\""}},
    {"name": "bound_is_empty", "diagnostic": "child_execution", "issue": "I436",
     "patch": {"file": "datamimic.xml", "old": "min=\"18\"", "new": "min=\"\""}},
