     "patch": {"file": "datamimic.xml", "old": "generator=\"IntegerGenerator\" min=\"18\"", "new": "generator=\"IntegerGen\" min=\"18\""}},
    {"name": "granularity_without_bounds", "diagnostic": "DM214",
     "patch": {"file": "datamimic.xml", "old": "name=\"score\" generator=\"FloatGenerator\" min=\"0\" max=\"1\" granularity", "new": "name=\"score\" generator=\"FloatGenerator\" granularity"}},
    {"name": "distribution_next_to_generator", "diagnostic": "DM218",
     "patch": {"file": "datamimic.xml", "old": "min=\"1\" max=\"5\"", "new": "min=\"1\" max=\"5\" distribution=\"cumulated\""}},
