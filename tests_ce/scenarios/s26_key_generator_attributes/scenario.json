     "patch": {"file": "datamimic.xml", "old": "<key name=\"member_id\"", "new": "<variable name=\"bonus\" generator=\"IntegerGenerator\" min=\"1\" max=\"2\"/>\n        <key name=\"member_id\""}}
  ]
}
