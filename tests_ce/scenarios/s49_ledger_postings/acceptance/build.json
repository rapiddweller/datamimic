{
  "version": "5.0",
  "max_count": 1000,
  "product_roles": [
    {"product": "policy", "field": "policy_id", "role": {"kind": "identifier"}},
    {"product": "customers", "field": "customer_id", "role": {"kind": "identifier"}},
    {"product": "accounts", "field": "account_id", "role": {"kind": "identifier"}},
    {"product": "invoices", "field": "invoice_id", "role": {"kind": "identifier"}},
    {"product": "payments", "field": "payment_id", "role": {"kind": "identifier"}},
    {"product": "invoice_amounts", "field": "invoice_id", "role": {"kind": "identifier"}},
    {"product": "plan", "field": "plan_id", "role": {"kind": "identifier"}},
    {"product": "allocations", "field": "allocation_id", "role": {"kind": "identifier"}},
    {"product": "split_evidence", "field": "split_id", "role": {"kind": "identifier"}},
    {"product": "invoice_entries", "field": "entry_id", "role": {"kind": "identifier"}},
    {"product": "invoice_lines", "field": "line_id", "role": {"kind": "identifier"}},
    {"product": "payment_entries", "field": "entry_id", "role": {"kind": "identifier"}},
    {"product": "payment_lines", "field": "line_id", "role": {"kind": "identifier"}},
    {"product": "ledger", "field": "ledger_id", "role": {"kind": "identifier"}},
    {"product": "ledger_lines", "field": "line_id", "role": {"kind": "identifier"}},
    {"product": "invoices", "field": "customer_id", "role": {"kind": "foreign_key", "parent_product": "customers", "parent_field": "customer_id"}},
    {"product": "payments", "field": "customer_id", "role": {"kind": "foreign_key", "parent_product": "customers", "parent_field": "customer_id"}},
    {"product": "invoice_amounts", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoices", "parent_field": "invoice_id"}},
    {"product": "allocations", "field": "payment_id", "role": {"kind": "foreign_key", "parent_product": "payments", "parent_field": "payment_id"}},
    {"product": "allocations", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoice_amounts", "parent_field": "invoice_id"}},
    {"product": "invoice_entries", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoice_amounts", "parent_field": "invoice_id"}},
    {"product": "payment_entries", "field": "payment_id", "role": {"kind": "foreign_key", "parent_product": "payments", "parent_field": "payment_id"}},
    {"product": "invoice_lines", "field": "entry_id", "role": {"kind": "foreign_key", "parent_product": "invoice_entries", "parent_field": "entry_id"}},
    {"product": "payment_lines", "field": "entry_id", "role": {"kind": "foreign_key", "parent_product": "payment_entries", "parent_field": "entry_id"}},
    {"product": "line_checks", "field": "line_id", "role": {"kind": "foreign_key", "parent_product": "ledger_lines", "parent_field": "line_id"}},
    {"product": "ledger_checks", "field": "ledger_id", "role": {"kind": "foreign_key", "parent_product": "ledger", "parent_field": "ledger_id"}},
    {"product": "invoice_amount_checks", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoice_amounts", "parent_field": "invoice_id"}},
    {"product": "allocation_checks", "field": "allocation_id", "role": {"kind": "foreign_key", "parent_product": "allocations", "parent_field": "allocation_id"}},
    {"product": "invoice_checks", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoices", "parent_field": "invoice_id"}},
    {"product": "payment_checks", "field": "payment_id", "role": {"kind": "foreign_key", "parent_product": "payments", "parent_field": "payment_id"}},
    {"product": "export_policy", "field": "policy_id", "role": {"kind": "foreign_key", "parent_product": "policy", "parent_field": "policy_id"}},
    {"product": "export_customers", "field": "customer_id", "role": {"kind": "foreign_key", "parent_product": "customers", "parent_field": "customer_id"}},
    {"product": "export_accounts", "field": "account_id", "role": {"kind": "foreign_key", "parent_product": "accounts", "parent_field": "account_id"}},
    {"product": "export_invoices", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoices", "parent_field": "invoice_id"}},
    {"product": "export_payments", "field": "payment_id", "role": {"kind": "foreign_key", "parent_product": "payments", "parent_field": "payment_id"}},
    {"product": "export_invoice_amounts", "field": "invoice_id", "role": {"kind": "foreign_key", "parent_product": "invoice_amounts", "parent_field": "invoice_id"}},
    {"product": "export_plan", "field": "plan_id", "role": {"kind": "foreign_key", "parent_product": "plan", "parent_field": "plan_id"}},
    {"product": "export_allocations", "field": "allocation_id", "role": {"kind": "foreign_key", "parent_product": "allocations", "parent_field": "allocation_id"}},
    {"product": "export_split_evidence", "field": "split_id", "role": {"kind": "foreign_key", "parent_product": "split_evidence", "parent_field": "split_id"}},
    {"product": "export_invoice_entries", "field": "entry_id", "role": {"kind": "foreign_key", "parent_product": "invoice_entries", "parent_field": "entry_id"}},
    {"product": "export_invoice_lines", "field": "line_id", "role": {"kind": "foreign_key", "parent_product": "invoice_lines", "parent_field": "line_id"}},
    {"product": "export_payment_entries", "field": "entry_id", "role": {"kind": "foreign_key", "parent_product": "payment_entries", "parent_field": "entry_id"}},
    {"product": "export_payment_lines", "field": "line_id", "role": {"kind": "foreign_key", "parent_product": "payment_lines", "parent_field": "line_id"}}
  ],
  "expectations": [
    {"kind": "row_condition", "subject": {"kind": "product", "product": "invoice_checks"}, "condition": "net_cents >= 1 and tax_rate_bp >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "payment_checks"}, "condition": "amount_cents >= 1"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "plan"}, "condition": "outcome != 'infeasible'"},
    {"kind": "group_sum", "subject": {"kind": "product", "product": "ledger_lines"}, "group_by": "entry_id", "field": "debit_cents", "equals_field": "credit_cents"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "one_sided"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "days_since_open >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "days_to_close == None or days_to_close >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "currency_matches"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "allow_negative == 'yes' or balance_after >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "days_to_period_close >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "invoice_amount_checks"}, "condition": "tax_error_tenth_basis <= 5000"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "invoice_amount_checks"}, "condition": "gross_is_net_plus_tax"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "payment_allocated == payment_amount"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "invoice_allocated <= invoice_gross"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "same_customer"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "days_after_invoice >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "proportion_error < due_total"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "ledger_checks"}, "condition": "total_debits == total_credits"}
  ],
  "acceptance_requirements": [
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "invoice_amount_checks"}, "condition": "invoice_id != 'I1' or tax_cents == 200"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "allocation_id != 'AL01' or amount_cents == 719"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "allocation_id != 'AL02' or amount_cents == 2281"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "allocation_checks"}, "condition": "allocation_id != 'AL06' or days_after_invoice == 0"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "line_id != 'JE-I3/3' or days_to_close == 0"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "line_checks"}, "condition": "line_id != 'JE-I3/3' or days_to_period_close == 0"}}
  ]
}
