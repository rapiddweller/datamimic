<setup>
    <!-- Suitability: for each person and plan day, decide which shift types the person may work (RS1, RS6) and why not. -->
    <generate name="staff_capacity" source="mem" sourceEntity="staff" distribution="ordered" target="mem">
        <variable name="contracts" source="mem" sourceEntity="contracts" storage="data" distribution="ordered"/>
        <key name="staff_id" script="staff_id"/>
        <key name="max_weekly_hours" script="{row.contract_id: row.max_weekly_hours for row in contracts}[contract_id]"/>
        <generate name="candidates" source="data/entity/calendar.ent.csv" distribution="ordered" target="mem">
            <variable name="holdings" source="mem" sourceEntity="staff_certifications" storage="data" distribution="ordered"/>
            <variable name="leave" source="mem" sourceEntity="leave" storage="data" distribution="ordered"/>
            <variable name="shift_types" source="mem" sourceEntity="shift_types" storage="data" distribution="ordered"/>
            <key name="shift_date" script="datetime.date.fromisoformat(shift_date)"/>
            <key name="candidate_id" script="f'{parent.staff_id}/{shift_date}'"/>
            <key name="staff_id" script="parent.staff_id"/>
            <key name="max_weekly_hours" script="parent.max_weekly_hours"/>
            <key name="on_leave" script="any(row.staff_id == staff_id and row.status == 'approved' and row.first_day &lt;= shift_date &lt;= row.last_day for row in leave)"/>
            <array name="valid_certs" script="sorted({row.cert_code for row in holdings if row.staff_id == staff_id and certificate_status(holdings, staff_id, row.cert_code, shift_date) == 'valid'})"/>
            <!-- One decision for each shift type: RS6 excludes a person on approved leave, RS1 one without the certification. -->
            <nestedKey name="shifts" script="[{'shift_code': row.shift_code, 'required_cert': row.required_cert} for row in shift_types]">
                <key name="cert_status" script="certificate_status(parent.holdings, parent.staff_id, required_cert, parent.shift_date)"/>
                <key name="excluded_by" script="'RS6' if parent.on_leave else None if cert_status == 'valid' else 'RS1'"/>
            </nestedKey>
            <array name="eligible_shifts" script="[row['shift_code'] for row in shifts if row['excluded_by'] is None]"/>
        </generate>
    </generate>
</setup>
