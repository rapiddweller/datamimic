<setup>
    <!-- Validate output: measure the complete roster against every rule again, from the data; Build compares the values. -->
    <generate name="entry_checks" source="mem" sourceEntity="roster" distribution="ordered" target="CSV">
        <variable name="roster" source="mem" sourceEntity="roster" storage="data" distribution="ordered"/>
        <variable name="holdings" source="mem" sourceEntity="staff_certifications" storage="data" distribution="ordered"/>
        <variable name="leave" source="mem" sourceEntity="leave" storage="data" distribution="ordered"/>
        <variable name="shift_types" source="mem" sourceEntity="shift_types" storage="data" distribution="ordered"/>
        <variable name="policy" source="mem" sourceEntity="policy" storage="data" distribution="ordered"/>
        <key name="entry_id" script="entry_id"/>
        <key name="slot_id" script="slot_id"/>
        <key name="staff_id" script="staff_id"/>
        <key name="required_cert" script="{row.shift_code: row.required_cert for row in shift_types}[shift_code]"/>
        <key name="cert_status" script="certificate_status(holdings, staff_id, required_cert, shift_date)"/>
        <variable name="start_of" script="{row.shift_code: datetime.time(row.start_hour) for row in shift_types}"/>
        <variable name="span_of" script="{row.shift_code: datetime.timedelta(hours=row.length_hours) for row in shift_types}"/>
        <!-- The id, start and length of each shift of this person, from the shift types, not from the slots of the search. -->
        <variable name="shifts" script="[(row.entry_id, datetime.datetime.combine(row.shift_date, start_of[row.shift_code]), span_of[row.shift_code]) for row in roster if row.staff_id == staff_id]"/>
        <variable name="starts_at" script="datetime.datetime.combine(shift_date, start_of[shift_code])"/>
        <!-- The end of each other shift that starts no later. The rest is negative when they overlap, None for the first shift. -->
        <variable name="earlier_ends" script="[start + span for entry, start, span in shifts if entry != entry_id and start &lt;= starts_at]"/>
        <key name="rest_hours" script="(starts_at - max(earlier_ends)).total_seconds() / 3600 if earlier_ends else None"/>
        <key name="min_rest_hours" script="policy[0].min_rest_hours"/>
        <key name="wards_that_day" script="len({row.ward_id for row in roster if row.staff_id == staff_id and row.shift_date == shift_date})"/>
        <key name="on_leave" script="any(row.staff_id == staff_id and row.status == 'approved' and row.first_day &lt;= shift_date &lt;= row.last_day for row in leave)"/>
    </generate>
    <generate name="hours_checks" source="mem" sourceEntity="staff_capacity" distribution="ordered" target="CSV">
        <variable name="roster" source="mem" sourceEntity="roster" storage="data" distribution="ordered"/>
        <variable name="contracts" source="mem" sourceEntity="contracts" storage="data" distribution="ordered"/>
        <variable name="shift_types" source="mem" sourceEntity="shift_types" storage="data" distribution="ordered"/>
        <key name="staff_id" script="staff_id"/>
        <!-- The lookup repeats staff_capacity on purpose: the RS3 check must not trust the input of the search. -->
        <key name="contract_hours" script="{row.contract_id: row.max_weekly_hours for row in contracts}[contract_id]"/>
        <variable name="length_of" script="{row.shift_code: row.length_hours for row in shift_types}"/>
        <!-- The ISO week (year, week) and the hours of each shift of this person; a shift counts fully in the week of its start. -->
        <variable name="shifts" script="[(row.shift_date.isocalendar()[:2], length_of[row.shift_code]) for row in roster if row.staff_id == staff_id]"/>
        <key name="busiest_week_hours" script="max((sum(hours for week, hours in shifts if week == busiest) for busiest, _ in shifts), default=0)"/>
    </generate>
    <generate name="coverage_checks" source="mem" sourceEntity="slots" distribution="ordered" target="CSV">
        <variable name="roster" source="mem" sourceEntity="roster" storage="data" distribution="ordered"/>
        <variable name="holdings" source="mem" sourceEntity="staff_certifications" storage="data" distribution="ordered"/>
        <key name="slot_id" script="slot_id"/>
        <key name="min_staff" script="min_staff"/>
        <key name="max_staff" script="max_staff"/>
        <key name="min_lead" script="min_lead"/>
        <key name="staffed" script="[row.slot_id for row in roster].count(slot_id)"/>
        <key name="leads" script="sum(certificate_status(holdings, row.staff_id, lead_cert, shift_date) == 'valid' for row in roster if row.slot_id == slot_id)"/>
    </generate>
</setup>
