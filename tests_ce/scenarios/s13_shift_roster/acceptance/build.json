{
  "version": "5.0",
  "max_count": 1000,
  "product_roles": [
    {"product": "policy", "field": "policy_id", "role": {"kind": "identifier"}},
    {"product": "contracts", "field": "contract_id", "role": {"kind": "identifier"}},
    {"product": "staff", "field": "staff_id", "role": {"kind": "identifier"}},
    {"product": "staff", "field": "contract_id", "role": {"kind": "foreign_key", "parent_product": "contracts", "parent_field": "contract_id"}},
    {"product": "certifications", "field": "cert_code", "role": {"kind": "identifier"}},
    {"product": "staff_certifications", "field": "holding_id", "role": {"kind": "identifier"}},
    {"product": "staff_certifications", "field": "staff_id", "role": {"kind": "foreign_key", "parent_product": "staff", "parent_field": "staff_id"}},
    {"product": "staff_certifications", "field": "cert_code", "role": {"kind": "foreign_key", "parent_product": "certifications", "parent_field": "cert_code"}},
    {"product": "wards", "field": "ward_id", "role": {"kind": "identifier"}},
    {"product": "shift_types", "field": "shift_code", "role": {"kind": "identifier"}},
    {"product": "shift_types", "field": "required_cert", "role": {"kind": "foreign_key", "parent_product": "certifications", "parent_field": "cert_code"}},
    {"product": "demand", "field": "demand_id", "role": {"kind": "identifier"}},
    {"product": "demand", "field": "ward_id", "role": {"kind": "foreign_key", "parent_product": "wards", "parent_field": "ward_id"}},
    {"product": "demand", "field": "shift_code", "role": {"kind": "foreign_key", "parent_product": "shift_types", "parent_field": "shift_code"}},
    {"product": "demand", "field": "lead_cert", "role": {"kind": "foreign_key", "parent_product": "certifications", "parent_field": "cert_code"}},
    {"product": "leave", "field": "leave_id", "role": {"kind": "identifier"}},
    {"product": "leave", "field": "staff_id", "role": {"kind": "foreign_key", "parent_product": "staff", "parent_field": "staff_id"}},
    {"product": "calendar", "field": "shift_date", "role": {"kind": "identifier"}},
    {"product": "slots", "field": "slot_id", "role": {"kind": "identifier"}},
    {"product": "slots", "field": "demand_id", "role": {"kind": "foreign_key", "parent_product": "demand", "parent_field": "demand_id"}},
    {"product": "staff_capacity", "field": "staff_id", "role": {"kind": "identifier"}},
    {"product": "staff_capacity", "field": "staff_id", "role": {"kind": "foreign_key", "parent_product": "staff", "parent_field": "staff_id"}},
    {"product": "candidates", "field": "candidate_id", "role": {"kind": "identifier"}},
    {"product": "candidates", "field": "shift_date", "role": {"kind": "foreign_key", "parent_product": "calendar", "parent_field": "shift_date"}},
    {"product": "plan", "field": "plan_id", "role": {"kind": "identifier"}},
    {"product": "roster", "field": "entry_id", "role": {"kind": "identifier"}},
    {"product": "roster", "field": "slot_id", "role": {"kind": "foreign_key", "parent_product": "slots", "parent_field": "slot_id"}},
    {"product": "roster", "field": "staff_id", "role": {"kind": "foreign_key", "parent_product": "staff", "parent_field": "staff_id"}},
    {"product": "slot_decisions", "field": "slot_id", "role": {"kind": "identifier"}},
    {"product": "entry_checks", "field": "entry_id", "role": {"kind": "foreign_key", "parent_product": "roster", "parent_field": "entry_id"}},
    {"product": "hours_checks", "field": "staff_id", "role": {"kind": "foreign_key", "parent_product": "staff_capacity", "parent_field": "staff_id"}},
    {"product": "coverage_checks", "field": "slot_id", "role": {"kind": "foreign_key", "parent_product": "slots", "parent_field": "slot_id"}},
    {"product": "export_policy", "field": "policy_id", "role": {"kind": "foreign_key", "parent_product": "policy", "parent_field": "policy_id"}},
    {"product": "export_contracts", "field": "contract_id", "role": {"kind": "foreign_key", "parent_product": "contracts", "parent_field": "contract_id"}},
    {"product": "export_staff", "field": "staff_id", "role": {"kind": "foreign_key", "parent_product": "staff", "parent_field": "staff_id"}},
    {"product": "export_certifications", "field": "cert_code", "role": {"kind": "foreign_key", "parent_product": "certifications", "parent_field": "cert_code"}},
    {"product": "export_staff_certifications", "field": "holding_id", "role": {"kind": "foreign_key", "parent_product": "staff_certifications", "parent_field": "holding_id"}},
    {"product": "export_wards", "field": "ward_id", "role": {"kind": "foreign_key", "parent_product": "wards", "parent_field": "ward_id"}},
    {"product": "export_shift_types", "field": "shift_code", "role": {"kind": "foreign_key", "parent_product": "shift_types", "parent_field": "shift_code"}},
    {"product": "export_demand", "field": "demand_id", "role": {"kind": "foreign_key", "parent_product": "demand", "parent_field": "demand_id"}},
    {"product": "export_leave", "field": "leave_id", "role": {"kind": "foreign_key", "parent_product": "leave", "parent_field": "leave_id"}},
    {"product": "export_calendar", "field": "shift_date", "role": {"kind": "foreign_key", "parent_product": "calendar", "parent_field": "shift_date"}},
    {"product": "export_candidates", "field": "candidate_id", "role": {"kind": "foreign_key", "parent_product": "candidates", "parent_field": "candidate_id"}},
    {"product": "export_plan", "field": "plan_id", "role": {"kind": "foreign_key", "parent_product": "plan", "parent_field": "plan_id"}},
    {"product": "export_roster", "field": "entry_id", "role": {"kind": "foreign_key", "parent_product": "roster", "parent_field": "entry_id"}},
    {"product": "export_slot_decisions", "field": "slot_id", "role": {"kind": "foreign_key", "parent_product": "slot_decisions", "parent_field": "slot_id"}}
  ],
  "expectations": [
    {"kind": "row_condition", "subject": {"kind": "product", "product": "policy"}, "condition": "search_budget != None and search_budget >= 1"},
    {"kind": "allowed_values", "subject": {"kind": "product", "product": "leave"}, "field": "status", "values": ["approved", "requested"]},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "leave"}, "condition": "days >= 1"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "staff_certifications"}, "condition": "valid_days == None or valid_days >= 0"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "demand"}, "condition": "min_staff <= max_staff and min_lead <= min_staff"},

    {"kind": "row_condition", "subject": {"kind": "product", "product": "plan"}, "condition": "outcome != 'infeasible'"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "plan"}, "condition": "search_complete == True"},

    {"kind": "row_condition", "subject": {"kind": "product", "product": "entry_checks"}, "condition": "cert_status == 'valid'"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "entry_checks"}, "condition": "rest_hours == None or rest_hours >= min_rest_hours"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "hours_checks"}, "condition": "busiest_week_hours <= contract_hours"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "coverage_checks"}, "condition": "staffed >= min_staff and staffed <= max_staff"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "coverage_checks"}, "condition": "leads >= min_lead"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "entry_checks"}, "condition": "wards_that_day == 1"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "entry_checks"}, "condition": "not on_leave"},

    {"kind": "row_condition", "subject": {"kind": "product", "product": "boundary_controls"}, "condition": "rules_week_hours == 11"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "boundary_controls"}, "condition": "week_search_outcome == 'solved'"},
    {"kind": "row_condition", "subject": {"kind": "product", "product": "boundary_controls"}, "condition": "rest_search_outcome == 'solved'"}
  ],
  "acceptance_requirements": [
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "policy"}, "condition": "min_rest_hours != None and min_rest_hours >= 11"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S07/2026-03-04' or 'night' in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S07/2026-03-05' or 'night' not in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "staff_id != 'S09' or 'night' not in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S14/2026-03-05' or 'day' in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S03/2026-03-04' or on_leave"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S03/2026-03-05' or not on_leave"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S06/2026-03-02' or 'night' not in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "plan"}, "condition": "backtracks >= 1"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S03/2026-03-02' or on_leave"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S06/2026-03-03' or 'night' in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "candidates"}, "condition": "candidate_id != 'S04/2026-03-02' or 'night' in eligible_shifts"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "hours_checks"}, "condition": "staff_id != 'S01' or busiest_week_hours == contract_hours"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "coverage_checks"}, "condition": "slot_id != '2026-03-02/W1/evening' or staffed == max_staff"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "slot_decisions"}, "condition": "slot_id != '2026-03-02/W1/night' or (blocked[0].staff_id == 'S01' and blocked[0].rule == 'RS2')"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "slot_decisions"}, "condition": "slot_id != '2026-03-02/W1/night' or (blocked[2].staff_id == 'S07' and blocked[2].rule == 'not_needed')"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "slot_decisions"}, "condition": "slot_id != '2026-03-02/W1/evening' or (blocked[1].staff_id == 'S02' and blocked[1].rule == 'RS4')"}}
  ]
}
