{
  "version": "5.0",
  "product_roles": [
    {"product": "orders", "field": "order_id", "role": {"kind": "identifier"}},
    {"product": "checks", "field": "order_id", "role": {
      "kind": "foreign_key", "parent_product": "orders", "parent_field": "order_id"
    }}
  ],
  "expectations": [
    {"kind": "exact_count", "subject": {"kind": "product", "product": "orders"}, "count": 3},
    {"kind": "exact_count", "subject": {"kind": "product", "product": "checks"}, "count": 3},
    {"kind": "unique", "subject": {"kind": "product", "product": "orders"}, "field": "order_id"}
  ],
  "acceptance_requirements": [
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "list_count == generator_count"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "order_id != 2 or (list_count == 2 and largest_qty == 5 and qty_total == 6 and qty_set == '[1, 5]' and pairs == 4)"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "order_id == 2 or (list_count == 1 and qty_total == largest_qty and pairs == 1)"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "order_id != 1 or closest_qty == 1"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "empty_count == 0"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "rebound_len == 10 and squared == (order_id + 1) * (order_id + 1)"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "orders"}, "condition": "field_wins == True"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "checks"}, "condition": "parent_count >= 1 and parent_count == root_count"}},
    {"origin": "caller", "expectation": {"kind": "row_condition", "subject": {"kind": "product", "product": "checks"}, "condition": "order_id != 2 or parent_count == 2"}}
  ]
}
