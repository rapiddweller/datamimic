{
  "title": "Script expressions: a comprehension, generator expression or lambda sees the same names as the expression",
  "proves": [
    "a list, set or dict comprehension, a generator expression and a lambda see the record's keys, variables, setup variables and this/parent/root, on every supported Python (#423)",
    "the same holds in count=, condition= and inside a nestedKey, and seeded random draws inside a generator expression or comprehension replay identically",
    "a name that a record binds wins over the engine's name of the same spelling, at the top level and in a nested scope alike",
    "an assignment expression binds only inside one evaluation: it changes neither the engine's names nor the next key or row",
    "a name that does not exist is named in the run error; the value of the expression is not shown"
  ],
  "products": {
    "orders": 3,
    "checks": 4
  },
  "negatives": [
    {
      "name": "missing_name_in_comprehension",
      "diagnostic": "child_execution",
      "run_error": "NameError: name 'order_no' is not defined",
      "patch": {
        "file": "datamimic.xml",
        "old": "len([line for line in lines if line['order'] == order_id])",
        "new": "len([line for line in lines if line['order'] == order_no])"
      }
    },
    {
      "name": "assignment_does_not_reach_the_next_key",
      "diagnostic": "child_execution",
      "run_error": "NameError: name 'side' is not defined",
      "patch": {
        "file": "datamimic.xml",
        "old": "script=\"order_id * 100\"",
        "new": "script=\"order_id * 100 + side\""
      }
    },
    {
      "name": "generator_expression_filter",
      "diagnostic": "row_condition",
      "expected": "list_count == generator_count",
      "patch": {
        "file": "datamimic.xml",
        "old": "if line['order'] == this.order_id)",
        "new": "if line['order'] != this.order_id)"
      }
    },
    {
      "name": "lambda_key",
      "diagnostic": "row_condition",
      "expected": "order_id != 1 or closest_qty == 1",
      "patch": {
        "file": "datamimic.xml",
        "old": "key=lambda qty: abs(qty - order_id)",
        "new": "key=lambda qty: -abs(qty - order_id)"
      }
    },
    {
      "name": "parent_in_generator_expression",
      "diagnostic": "row_condition",
      "expected": "parent_count >= 1 and parent_count == root_count",
      "patch": {
        "file": "datamimic.xml",
        "old": "if line.order == parent.order_id)",
        "new": "if line.order == parent.order_id + 1)"
      }
    },
    {
      "name": "field_shadows_engine_name",
      "diagnostic": "row_condition",
      "expected": "field_wins == True",
      "patch": {
        "file": "datamimic.xml",
        "old": "sum(round for line in lines",
        "new": "sum(round + 1 for line in lines"
      }
    },
    {
      "name": "count_generator_expression",
      "diagnostic": "exact_count",
      "patch": {
        "file": "datamimic.xml",
        "old": "lines if line['order'] == order_id)}",
        "new": "lines if line['order'] == order_id + 1)}"
      }
    },
    {
      "name": "condition_generator_expression",
      "diagnostic": "row_condition",
      "expected": "3 <= dice <= 18 and len(pick) == 2 and positive == 'yes'",
      "patch": {
        "file": "datamimic.xml",
        "old": "all(line['qty'] &gt; 0 for",
        "new": "all(line['qty'] &gt; 4 for"
      }
    },
    {
      "name": "nested_key_comprehension",
      "diagnostic": "row_condition",
      "expected": "hits[0]['n'] == list_count",
      "patch": {
        "file": "datamimic.xml",
        "old": "if root.order_id == line.order]",
        "new": "if root.order_id != line.order]"
      }
    }
  ]
}
