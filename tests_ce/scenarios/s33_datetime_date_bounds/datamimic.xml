<setup rngSeed="61423">
    <!-- Dates YYYY-MM-DD from DateTimeGenerator: the default layout has a time, so each bound carries one,
         and outDateFormat writes the date text. -->
    <generate name="licenses" count="20">
        <key name="license_id" generator="IncrementGenerator"/>
        <key name="valid_from" generator="DateTimeGenerator" min="2026-01-01 00:00:00" max="2026-03-31 23:59:59"
             outDateFormat="%Y-%m-%d"/>
        <variable name="expiry" generator="DateTimeGenerator(min='2026-03-01 00:00:00', max='2026-12-31 00:00:00')"
                  outDateFormat="%Y-%m-%d"/>
        <key name="expires_on" script="None if license_id % 4 == 0 else expiry"/>
        <!-- A script never imports: the datetime module is already there. -->
        <key name="issued_on" script="(datetime.date(2026, 1, 1) + datetime.timedelta(days=license_id)).isoformat()"/>
    </generate>
</setup>
