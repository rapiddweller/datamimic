<setup rngSeed="21">
    <include uri="conf/audit.properties"/>
    <generate name="items" source="data/entity/items.json" distribution="ordered">
        <key name="sku" script="this.sku"/>
        <key name="qty" script="this.qty"/>
    </generate>
    <generate name="lines" count="4">
        <variable name="item" source="data/entity/items.json" distribution="ordered"/>
        <key name="line_no" generator="IncrementGenerator"/>
        <key name="qty" script="item.qty"/>
        <assert condition="this.qty &lt;= 4" message="A line holds at most 4 items"/>
        <assert condition="this.qty &lt; 20" message="A line holds fewer than 20 items"/>
        <generate name="parts" count="2">
            <key name="line_no" script="parent.line_no"/>
            <key name="part_no" generator="IncrementGenerator"/>
            <assert condition="this.part_no &lt;= 2" message="A line has at most 2 parts"/>
        </generate>
    </generate>
    <include uri="model/10_stock.xml"/>
</setup>
