    {"name": "r1_company", "diagnostic": "row_condition", "expected": "unfilled_by.R1_company == 0", "patch": {"file": "data/employments.json", "old": "{\"person_id\": 47, \"company_id\": \"C05\", \"function_id\": \"INS\"}", "new": "{\"person_id\": 47, \"company_id\": \"C10\", \"function_id\": \"INS\"}"}},
    {"name": "r1_function", "diagnostic": "row_condition", "expected": "unfilled_by.R1_function == 0", "patch": {"file": "data/employments.json", "old": "{\"person_id\": 47, \"company_id\": \"C05\", \"function_id\": \"INS\"}", "new": "{\"person_id\": 47, \"company_id\": \"C05\", \"function_id\": \"PLN\"}"}},
    {"name": "r2_missing", "diagnostic": "row_condition", "expected": "unfilled_by.R2 == 0", "patch": {"file": "data/person_licenses.json", "old": "{\"person_id\": 47, \"license_type\": \"BASE\", \"status\": \"active\", \"expires_on\": \"2026-03-01\"}", "new": "{\"person_id\": 47, \"license_type\": \"TRAINEE\", \"status\": \"active\", \"expires_on\": \"2026-03-01\"}"}},
