    "companies": 10,
    "people": 100,
    "functions": 4,
    "employments": 105,
    "licenses": 2,
    "person_licenses": 102,
    "qualifications": 4,
    "person_qualifications": 98,
    "approvals": 11,
    "approval_versions": 22,
    "staffing": 82
  },
