<setup>
    <!-- Export: write the eleven target tables to CSV; staffing reads the checked plan back from the memstore.
         The keys list the 27 target columns. They do not filter: a source field outside the list still reaches the CSV (#420). -->
    <generate name="companies" source="data/entity/companies.json" distribution="ordered" target="CSV">
        <key name="company_id" script="this.company_id"/>
        <key name="company_name" script="this.company_name"/>
    </generate>
    <generate name="people" source="data/entity/people.json" distribution="ordered" target="CSV">
        <key name="person_id" script="this.person_id"/>
        <key name="full_name" script="this.full_name"/>
    </generate>
    <generate name="functions" source="data/entity/functions.json" distribution="ordered" target="CSV">
        <key name="function_id" script="this.function_id"/>
        <key name="function_name" script="this.function_name"/>
    </generate>
    <generate name="employments" source="data/entity/employments.json" distribution="ordered" target="CSV">
        <key name="person_id" script="this.person_id"/>
        <key name="company_id" script="this.company_id"/>
        <key name="function_id" script="this.function_id"/>
    </generate>
    <generate name="licenses" source="data/entity/licenses.json" distribution="ordered" target="CSV">
        <key name="license_type" script="this.license_type"/>
    </generate>
    <generate name="person_licenses" source="data/entity/person_licenses.json" distribution="ordered" target="CSV">
        <key name="person_id" script="this.person_id"/>
        <key name="license_type" script="this.license_type"/>
        <key name="status" script="this.status"/>
        <key name="expires_on" script="this.expires_on"/>
    </generate>
    <generate name="qualifications" source="data/entity/qualifications.json" distribution="ordered" target="CSV">
        <key name="qualification_id" script="this.qualification_id"/>
        <key name="qualification_name" script="this.qualification_name"/>
    </generate>
    <generate name="person_qualifications" source="data/entity/person_qualifications.json" distribution="ordered" target="CSV">
        <key name="person_id" script="this.person_id"/>
        <key name="qualification_id" script="this.qualification_id"/>
    </generate>
    <generate name="approvals" source="data/entity/approvals.json" distribution="ordered" target="CSV">
        <key name="approval_id" script="this.approval_id"/>
        <key name="company_id" script="this.company_id"/>
    </generate>
    <generate name="approval_versions" source="data/entity/approval_versions.json" distribution="ordered" target="CSV">
        <key name="version_id" script="this.version_id"/>
        <key name="approval_id" script="this.approval_id"/>
        <key name="valid_on" script="this.valid_on"/>
    </generate>
    <generate name="staffing" source="mem" sourceEntity="plan" distribution="ordered" target="CSV">
        <key name="seat_id" script="this.seat_id"/>
        <key name="version_id" script="this.version_id"/>
        <key name="function_id" script="this.function_id"/>
        <key name="person_id" script="this.person_id"/>
    </generate>
    <!-- The rule parameters and the search counters, read back from the store. -->
    <generate name="export_policy" source="mem" sourceEntity="policy" distribution="ordered" target="JSON" targetEntity="policy">
        <key name="policy_id" script="this.policy_id"/>
    </generate>
    <generate name="export_assignment" source="mem" sourceEntity="assignment" distribution="ordered" target="JSON" targetEntity="assignment">
        <key name="assignment_id" script="this.assignment_id"/>
    </generate>
</setup>
