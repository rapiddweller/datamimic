<setup>
    <!-- Assign: one search fills every seat under R4 to R6 and records each decision; no plan unless complete. -->
    <generate name="assignment" count="1" target="mem">
        <variable name="positions" source="mem" sourceEntity="suitability" storage="data" distribution="ordered"/>
        <variable name="policy_rows" source="mem" sourceEntity="policy" storage="data" distribution="ordered"/>
        <variable name="policy" script="read_policy(policy_rows[0])"/>
        <variable name="people" source="data/entity/people.json" storage="data" distribution="ordered"/>
        <variable name="result" script="assign_seats(positions, policy)"/>
        <key name="assignment_id" script="1"/>
        <key name="outcome" script="result.outcome"/>
        <key name="nodes" script="result.nodes"/>
        <key name="backtracks" script="result.backtracks"/>
        <nestedKey name="unfilled_by" script="result.unfilled_by"/>
        <nestedKey name="skipped_by" script="result.skipped_by"/>
        <generate name="plan" script="result.seats" count="{len(result.seats)}" distribution="ordered" target="mem">
            <key name="seat_id" script="this.seat_id"/>
            <key name="version_id" script="this.version_id"/>
            <key name="function_id" script="this.function_id"/>
            <key name="person_id" script="this.person_id"/>
        </generate>
        <!-- One row per rejection of the search (skip, dead end, undo, short), with the person's name; the plan holds the choices. -->
        <generate name="trace" script="result.decisions" count="{len(result.decisions)}" distribution="ordered" target="JSON">
            <key name="position_id" script="this.position_id"/>
            <key name="seat_id" script="this.seat_id"/>
            <key name="person_id" script="this.person_id"/>
            <key name="full_name" script="{row.person_id: row.full_name for row in root.people}.get(this.person_id)"/>
            <key name="action" script="this.action"/>
            <key name="rule" script="this.rule"/>
            <key name="reason" script="this.reason"/>
        </generate>
    </generate>
</setup>
