<setup>
    <!-- Assign: one search fills every seat under R4 to R6 and records each decision; no plan unless complete. -->
    <generate name="assignment" count="1" target="JSON">
        <variable name="positions" source="mem" sourceEntity="suitability" storage="data" distribution="ordered"/>
        <variable name="policy" source="data/policy.json" storage="value" distribution="ordered"/>
        <variable name="result" script="assign_seats(positions, policy)"/>
        <key name="outcome" script="result.outcome"/>
        <key name="nodes" script="result.nodes"/>
        <key name="backtracks" script="result.backtracks"/>
        <nestedKey name="unfilled_by" script="result.unfilled_by"/>
        <nestedKey name="decisions" script="result.decisions"/>
        <generate name="plan" script="result.seats" count="{len(result.seats)}" target="mem">
            <key name="seat_id" script="this.seat_id"/>
            <key name="version_id" script="this.version_id"/>
            <key name="function_id" script="this.function_id"/>
            <key name="person_id" script="this.person_id"/>
        </generate>
    </generate>
</setup>
