<setup>
    <!-- Suitability: decide R1 to R3 for every person and position; count the exclusions by rule and name the near misses. -->
    <generate name="suitability" source="mem" sourceEntity="positions" distribution="ordered" target="mem">
        <variable name="people" source="mem" sourceEntity="people" storage="data" distribution="ordered"/>
        <variable name="employments" source="mem" sourceEntity="employments" storage="data" distribution="ordered"/>
        <variable name="person_licenses" source="mem" sourceEntity="person_licenses" storage="data" distribution="ordered"/>
        <variable name="person_qualifications" source="mem" sourceEntity="person_qualifications" storage="data" distribution="ordered"/>
        <variable name="policy_rows" source="mem" sourceEntity="policy" storage="data" distribution="ordered"/>
        <variable name="policy" script="read_policy(policy_rows[0])"/>
        <variable name="verdict" script="suitable_people(this.company_id, this.function_id, this.valid_on, people, employments, person_licenses, person_qualifications, policy)"/>
        <key name="position_id" script="this.position_id"/>
        <nestedKey name="eligible" script="verdict.eligible"/>
        <nestedKey name="near_misses" script="verdict.near_misses"/>
        <nestedKey name="excluded_by" script="verdict.excluded_by"/>
    </generate>
</setup>
