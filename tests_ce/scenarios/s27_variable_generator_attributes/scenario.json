{
  "title": "A variable and an element pass min, max, granularity, minLength and maxLength to their generator as attributes (#460)",
  "proves": [
    "<variable generator=\"IntegerGenerator\" min= max=> draws inside the bounds, in a generate and at setup scope",
    "FloatGenerator takes granularity=, DateTimeGenerator its text bounds, StringGenerator minLength= and maxLength=",
    "<element generator= min= max=> applies the bounds instead of ignoring them",
    "each attribute form gives the same rows as the call form for the same seed",
    "an attribute the generator does not take is refused with I438, an attribute next to a call with I439",
    "a variable bound without generator= is refused (DM214), also next to type=, values= or entity="
  ],
  "products": {
    "bookings": 25
  },
  "equivalents": [
    {
      "name": "setup_variable_call_form",
      "patch": {
        "file": "datamimic.xml",
        "old": "generator=\"IntegerGenerator\" min=\"7\" max=\"7\"",
        "new": "generator=\"IntegerGenerator(min=7, max=7)\""
      }
    },
    {
      "name": "integer_call_form",
      "patch": {
        "file": "datamimic.xml",
        "old": "generator=\"IntegerGenerator\" min=\"1\" max=\"14\"",
        "new": "generator=\"IntegerGenerator(min=1, max=14)\""
      }
    },
    {
      "name": "float_call_form",
      "patch": {
        "file": "datamimic.xml",
        "old": "generator=\"FloatGenerator\" min=\"50\" max=\"100\" granularity=\"25\"",
        "new": "generator=\"FloatGenerator(min=50, max=100, granularity=25)\""
      }
    },
    {
      "name": "datetime_call_form",
      "patch": {
        "file": "datamimic.xml",
        "old": "generator=\"DateTimeGenerator\" min=\"2026-03-01 00:00:00\" max=\"2026-03-31 23:59:59\"",
        "new": "generator=\"DateTimeGenerator(min='2026-03-01 00:00:00', max='2026-03-31 23:59:59')\""
      }
    },
    {
      "name": "string_length_call_form",
      "patch": {
        "file": "datamimic.xml",
        "old": "generator=\"StringGenerator\" minLength=\"6\" maxLength=\"6\"",
        "new": "generator=\"StringGenerator(min_len=6, max_len=6)\""
      }
    },
    {
      "name": "element_call_form",
      "patch": {
        "file": "datamimic.xml",
        "old": "generator=\"IntegerGenerator\" min=\"1\" max=\"9\"",
        "new": "generator=\"IntegerGenerator(min=1, max=9)\""
      }
    }
  ],
