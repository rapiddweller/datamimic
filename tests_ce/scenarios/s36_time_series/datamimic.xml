<setup rngSeed="36">
    <generate name="readings" count="3" start="2026-03-01T00:00:00" end="2026-03-01T06:00:00" interval="PT1H">
        <key name="sensor" script="'sensor-' + str(ts.series)"/>
        <key name="recorded_at" script="ts.now.isoformat()"/>
        <key name="hour" script="ts.step"/>
        <key name="temperature_c" type="int" min="15" max="30"/>
    </generate>
</setup>
