{
 "version": "5.0",
 "max_count": 1000,
 "product_roles": [
  {
   "product": "policy",
   "field": "policy_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "products",
   "field": "product_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "customers",
   "field": "customer_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "lots",
   "field": "lot_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "lots",
   "field": "product_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "products",
    "parent_field": "product_id"
   }
  },
  {
   "product": "orders",
   "field": "order_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "orders",
   "field": "customer_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "customers",
    "parent_field": "customer_id"
   }
  },
  {
   "product": "orders",
   "field": "product_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "products",
    "parent_field": "product_id"
   }
  },
  {
   "product": "order_lots",
   "field": "order_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "order_lots",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "orders",
    "parent_field": "order_id"
   }
  },
  {
   "product": "plan",
   "field": "plan_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "allocations",
   "field": "allocation_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "allocations",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "orders",
    "parent_field": "order_id"
   }
  },
  {
   "product": "allocations",
   "field": "lot_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "lots",
    "parent_field": "lot_id"
   }
  },
  {
   "product": "order_decisions",
   "field": "order_id",
   "role": {
    "kind": "identifier"
   }
  },
  {
   "product": "order_decisions",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "order_lots",
    "parent_field": "order_id"
   }
  },
  {
   "product": "lot_checks",
   "field": "lot_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "lots",
    "parent_field": "lot_id"
   }
  },
  {
   "product": "order_checks_input",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "orders",
    "parent_field": "order_id"
   }
  },
  {
   "product": "allocation_checks",
   "field": "allocation_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "allocations",
    "parent_field": "allocation_id"
   }
  },
  {
   "product": "order_checks",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "orders",
    "parent_field": "order_id"
   }
  },
  {
   "product": "export_policy",
   "field": "policy_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "policy",
    "parent_field": "policy_id"
   }
  },
  {
   "product": "export_products",
   "field": "product_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "products",
    "parent_field": "product_id"
   }
  },
  {
   "product": "export_customers",
   "field": "customer_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "customers",
    "parent_field": "customer_id"
   }
  },
  {
   "product": "export_lots",
   "field": "lot_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "lots",
    "parent_field": "lot_id"
   }
  },
  {
   "product": "export_orders",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "orders",
    "parent_field": "order_id"
   }
  },
  {
   "product": "export_order_lots",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "order_lots",
    "parent_field": "order_id"
   }
  },
  {
   "product": "export_order_decisions",
   "field": "order_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "order_decisions",
    "parent_field": "order_id"
   }
  },
  {
   "product": "export_plan",
   "field": "plan_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "plan",
    "parent_field": "plan_id"
   }
  },
  {
   "product": "export_allocations",
   "field": "allocation_id",
   "role": {
    "kind": "foreign_key",
    "parent_product": "allocations",
    "parent_field": "allocation_id"
   }
  }
 ],
 "expectations": [
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "policy"
   },
   "condition": "max_lots_per_order >= 1 and search_budget >= 1"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "lot_checks"
   },
   "condition": "quantity >= 1"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "order_checks_input"
   },
   "condition": "quantity >= 1"
  },
  {
   "kind": "allowed_values",
   "subject": {
    "kind": "product",
    "product": "order_checks_input"
   },
   "field": "allow_partial",
   "values": [
    "yes",
    "no"
   ]
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "plan"
   },
   "condition": "outcome != 'infeasible'"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "plan"
   },
   "condition": "search_complete == True"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "allocation_checks"
   },
   "condition": "same_product"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "allocation_checks"
   },
   "condition": "days_to_expiry >= 0"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "allocation_checks"
   },
   "condition": "lot_allocated <= lot_quantity"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "allocation_checks"
   },
   "condition": "lots_of_order <= 2"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "order_checks"
   },
   "condition": "allow_partial == 'yes' or backordered == 0"
  },
  {
   "kind": "row_condition",
   "subject": {
    "kind": "product",
    "product": "order_checks"
   },
   "condition": "backordered == 0 or valid_left == 0"
  }
 ],
 "acceptance_requirements": [
  {
   "origin": "caller",
   "expectation": {
    "kind": "row_condition",
    "subject": {
     "kind": "product",
     "product": "policy"
    },
    "condition": "max_lots_per_order <= 2"
   }
  },
  {
   "origin": "caller",
   "expectation": {
    "kind": "row_condition",
    "subject": {
     "kind": "product",
     "product": "plan"
    },
    "condition": "backtracks >= 1"
   }
  },
  {
   "origin": "caller",
   "expectation": {
    "kind": "row_condition",
    "subject": {
     "kind": "product",
     "product": "allocation_checks"
    },
    "condition": "allocation_id != 'A04' or days_to_expiry == 0"
   }
  },
  {
   "origin": "caller",
   "expectation": {
    "kind": "row_condition",
    "subject": {
     "kind": "product",
     "product": "order_checks"
    },
    "condition": "order_id != 'O6' or shipped == 0"
   }
  },
  {
   "origin": "caller",
   "expectation": {
    "kind": "row_condition",
    "subject": {
     "kind": "product",
     "product": "order_checks"
    },
    "condition": "order_id != 'O7' or (shipped == 2 and backordered == 2)"
   }
  },
  {
   "origin": "caller",
   "expectation": {
    "kind": "row_condition",
    "subject": {
     "kind": "product",
     "product": "order_checks"
    },
    "condition": "order_id != 'O5' or backordered == 0"
   }
  }
 ]
}
