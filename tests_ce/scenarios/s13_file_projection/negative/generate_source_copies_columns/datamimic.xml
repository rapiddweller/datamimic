<setup rngSeed="51110">
    <generate name="priced_orders" source="fixtures/orders.csv" separator="," distribution="ordered" target="JSON">
        <key name="order_id" script="order_id"/>
        <key name="customer_id" script="customer_id"/>
        <key name="total_cents" script="int(total_cents)"/>
        <key name="priority" script="'high' if int(total_cents) >= 5000 else 'standard'"/>
    </generate>
</setup>
