<setup rngSeed="1">
    <memstore id="mem"/>
    <generate name="types" count="2" target="mem">
        <key name="code" generator="IncrementGenerator"/>
    </generate>
    <generate name="teams" count="2" target="mem">
        <key name="team_id" generator="IncrementGenerator"/>
        <nestedKey name="tags" type="list" count="1">
            <key name="label" constant="base"/>
        </nestedKey>
    </generate>
    <generate name="grids" count="1" target="mem">
        <key name="grid_id" generator="IncrementGenerator"/>
        <nestedKey name="grid" type="list" count="1">
            <array name="cells" script="[1, 2]"/>
        </nestedKey>
    </generate>
    <generate name="probe" count="1">
        <variable name="types" source="mem" sourceEntity="types" storage="data" distribution="ordered"/>
        <variable name="teams" source="mem" sourceEntity="teams" storage="data" distribution="ordered"/>
        <nestedKey name="items" script="[t.to_dict() for t in types]">
            <key name="mark" constant="written by probe"/>
        </nestedKey>
        <nestedKey name="labels" script="[tag for team in teams for tag in team.tags]">
            <key name="mark" constant="written by probe"/>
        </nestedKey>
        <nestedKey name="sourced" source="mem" sourceEntity="types" distribution="ordered" count="2">
            <key name="mark" constant="written by probe"/>
        </nestedKey>
        <key name="marked_items" script="len([item for item in this.items if 'mark' in item])"/>
        <key name="marked_sourced" script="len([row for row in this.sourced if 'mark' in row])"/>
        <key name="marked_labels" script="len([label for label in this.labels if 'mark' in label])"/>
    </generate>
    <!-- Each key tries to change the store through a script: an iterated row, a list of rows, a nested list leaf. -->
    <generate name="mutator" count="2">
        <variable name="team" source="mem" sourceEntity="teams" distribution="ordered"/>
        <variable name="all_types" source="mem" sourceEntity="types" storage="data" distribution="ordered"/>
        <variable name="all_grids" source="mem" sourceEntity="grids" storage="data" distribution="ordered"/>
        <key name="tag_edit" script="team.tags[0].to_dict().update(label='changed') or team.tags.append(1) or 0"/>
        <key name="cleared" script="all_types.clear() or len(all_types)"/>
        <key name="cell_edit" script="all_grids[0].grid[0].cells.append(99) or 0"/>
    </generate>
    <generate name="readback" source="mem" sourceEntity="types" distribution="ordered">
        <key name="code" script="this.code"/>
    </generate>
    <generate name="team_readback" source="mem" sourceEntity="teams" distribution="ordered">
        <key name="team_id" script="this.team_id"/>
        <key name="tag_count" script="len(this.tags)"/>
        <key name="first_label" script="this.tags[0].label"/>
    </generate>
    <generate name="grid_readback" source="mem" sourceEntity="grids" distribution="ordered">
        <key name="grid_id" script="this.grid_id"/>
        <key name="cell_count" script="len(this.grid[0].cells)"/>
    </generate>
</setup>
