<!-- Banking core: customers -> accounts -> transactions, three levels deep.
     Every child key references a real parent key: accounts carry their customer_id
     via parent.*, transactions carry their account_id via parent.* AND the owning
     customer_id via root.* (a two-hop foreign key). A second pass then reads the
     accounts back from the memstore and derives statements from real rows.
     Seeded: the same descriptor reproduces the identical dataset on every run. -->
<setup rngSeed="42">
    <memstore id="bank"/>

    <generate name="customers" count="40" target="bank,JSON" exportUri="output">
        <key name="customer_id" generator="IncrementGenerator"/>
        <variable name="person" entity="Person" dataset="DE" locale="de"/>
        <key name="full_name" script="person.name"/>
        <key name="email" script="person.email"/>
        <key name="segment" values="'retail','private','business'" weights="0.7,0.2,0.1"/>

        <!-- 1..3 accounts per customer; the FK is the parent's real key.
             IncrementGenerator restarts for every parent record inside a nested
             <generate> (it counts per parent, not globally), so the globally
             unique account_id is composed from the parent key plus the local
             account_no. Inside a nested scope, an earlier sibling key must be
             addressed as this.field (bare names only resolve at the top level). -->
        <generate name="accounts" minCount="1" maxCount="3" target="bank,JSON" exportUri="output">
            <key name="account_no" generator="IncrementGenerator"/>
            <key name="account_id" script="parent.customer_id * 10 + this.account_no"/>
            <key name="customer_id" script="parent.customer_id"/>
            <key name="iban" pattern="DE[0-9]{2}50010517[0-9]{8}"/>
            <key name="account_type" values="'checking','savings'" weights="0.8,0.2"/>
            <key name="balance" type="decimal" min="0" max="250000"/>

            <!-- 2..6 transactions per account; two-hop FK back to the customer -->
            <generate name="transactions" minCount="2" maxCount="6" target="bank,JSON" exportUri="output">
                <key name="line_no" generator="IncrementGenerator"/>
                <key name="account_id" script="parent.account_id"/>
                <key name="tx_id" script="this.account_id * 100 + this.line_no"/>
                <key name="customer_id" script="root.customer_id"/>
                <key name="amount" type="decimal" min="1" max="5000"/>
                <key name="direction" values="'debit','credit'" weights="0.6,0.4"/>
                <key name="tx_type" values="'card','sepa_credit','sepa_debit','fee'"
                     weights="0.5,0.25,0.2,0.05"/>
                <key name="currency" constant="EUR"/>
            </generate>
        </generate>
    </generate>

    <!-- Second pass: read accounts back from the memstore (ordered = stable),
         derive a statement per account from the REAL generated rows. -->
    <generate name="account_statements" source="bank" type="accounts"
              distribution="ordered" target="JSON" exportUri="output">
        <key name="balance_band" script="'high' if float(balance) &gt; 100000 else 'normal'"/>
    </generate>
</setup>
