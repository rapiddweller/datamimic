<!-- Conditional orchestration + time-series in one descriptor.
     1. loan_applications: <condition> with if / else-if / else routes each
        record into a decision branch based on its own generated score.
     2. fx_ticks: <generate start/end/interval> iterates over time instead of
        a count; count="2" means two SERIES (two currency pairs). Every tick
        exposes ts.now (timestamp), ts.step (tick index), ts.series (series
        index) to script=. Deterministic drift, no seed needed for ts.*. -->
<setup rngSeed="3">
    <generate name="loan_applications" count="30" target="JSON" exportUri="output">
        <key name="application_id" generator="IncrementGenerator"/>
        <key name="score" type="int" min="300" max="850"/>
        <condition>
            <if condition="score >= 700">
                <key name="decision" constant="approved"/>
                <key name="rate_pct" type="float" min="3.1" max="4.5"/>
            </if>
            <else-if condition="score >= 550">
                <key name="decision" constant="manual_review"/>
                <key name="rate_pct" type="float" min="4.6" max="7.9"/>
            </else-if>
            <else>
                <key name="decision" constant="declined"/>
            </else>
        </condition>
    </generate>

    <generate name="fx_ticks" start="2025-03-03T09:00:00" end="2025-03-03T17:30:00"
              interval="PT30M" count="2" target="JSON" exportUri="output">
        <key name="pair" script="['EUR/USD', 'EUR/GBP'][ts.series]"/>
        <key name="observed_at" script="ts.now"/>
        <key name="tick" script="ts.step"/>
        <key name="mid" script="round((1.0850 if ts.series == 0 else 0.8570) + 0.0004 * ts.step, 4)"/>
    </generate>
</setup>
