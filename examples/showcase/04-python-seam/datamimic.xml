<!-- The python seam: DSL for structure and orchestration, python for the pieces
     that need it. Three integration levels:
     1. <execute uri="*.scr.py"> loads custom classes into the context; the DSL
        then uses them like built-ins: generator="MaskedPanGenerator()",
        converter="RiskBucketConverter()".
     2. script= evaluates inline python per record.
     3. analyze.py (next to this file) is a PLAIN python script run after the
        engine: reporting over the generated JSON is ordinary code, not DSL. -->
<setup rngSeed="9">
    <execute uri="script/components.scr.py"/>

    <generate name="cards" count="25" target="JSON" exportUri="output">
        <key name="card_id" generator="IncrementGenerator"/>
        <variable name="holder" entity="Person" dataset="DE" locale="de"/>
        <key name="holder_name" script="holder.name"/>
        <key name="pan_masked" generator="MaskedPanGenerator()"/>
        <key name="limit_eur" type="int" min="500" max="20000"/>
        <key name="risk_bucket" script="limit_eur" converter="RiskBucketConverter()"/>
        <key name="utilization_pct" script="round(min(100, limit_eur % 97), 1)"/>
    </generate>
</setup>
