<!-- Read tabular data in ORDER, derive/mask fields with Python, export JSON.
     The handoff runs through a <memstore> so the recipe also works under dry-run
     (file targets are neutralized there). For a real CSV file, point the second
     statement at it instead: source="data/customers.csv" (extension picks the reader). -->
<setup rngSeed="1" defaultSeparator=",">
    <memstore id="mem"/>

    <generate name="raw_customers" count="25" target="mem,CSV" exportUri="recipe_out">
        <key name="customer_id" generator="IncrementGenerator"/>
        <key name="email" pattern="[a-z]{6}@example\.com"/>
        <key name="plan" values="'free','pro','enterprise'" weights="0.6,0.3,0.1"/>
    </generate>

    <!-- ordered = source order and page-by-page reading (absent distribution would shuffle!) -->
    <iterate name="customers" source="mem" type="raw_customers"
             distribution="ordered" target="JSON" exportUri="recipe_out">
        <key name="id" script="customer_id"/>
        <key name="email_masked" script="email.split('@')[0][:2] + '***@' + email.split('@')[1]"/>
        <key name="is_paid" script="plan != 'free'"/>
    </iterate>
</setup>
