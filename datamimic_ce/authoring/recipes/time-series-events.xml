<!-- Time-series: <generate start/end/interval> iterates over time. Each tick exposes
     a read-only `ts` object to script= (ts.now / ts.step / ts.series). count = number
     of SERIES; total rows = count x ticks_per_series. Reproducible without a seed. -->
<setup rngSeed="1">
    <generate name="sensor_readings"
              start="2025-01-01T00:00:00" end="2025-01-01T12:00:00" interval="PT1H"
              count="3" target="JSON" exportUri="recipe_out">
        <key name="device_id" script="'sensor-' + str(ts.series)"/>
        <key name="hour_index" script="ts.step"/>
        <key name="timestamp" script="ts.now"/>
        <key name="temperature" type="float" min="15.0" max="28.0"/>
        <key name="status" values="'ok','warn','alert'" weights="0.8,0.15,0.05"/>
    </generate>
</setup>
