<!-- Deeply nested documents for JSON/document stores: dict via <nestedKey type="dict">,
     arrays of objects via <nestedKey type="list"> or <list>/<item>. -->
<setup rngSeed="1">
    <generate name="patients" count="10" target="JSON" exportUri="recipe_out">
        <key name="patient_id" generator="IncrementGenerator"/>

        <nestedKey name="contact" type="dict">
            <key name="email" pattern="[a-z]{5}@clinic\.example"/>
            <key name="phone" pattern="\+49-30-[0-9]{7}"/>
        </nestedKey>

        <!-- an array of 2..3 visit objects -->
        <nestedKey name="visits" type="list" minCount="2" maxCount="3">
            <key name="visit_id" generator="IncrementGenerator"/>
            <key name="ward" values="'ER','ICU','GEN'"/>
        </nestedKey>

        <!-- fixed-shape tuple-style list -->
        <list name="flags">
            <item><key name="flag" constant="active"/></item>
            <item><key name="flag" script="'insured' if patient_id % 2 == 0 else 'self-pay'"/></item>
        </list>
    </generate>
</setup>
