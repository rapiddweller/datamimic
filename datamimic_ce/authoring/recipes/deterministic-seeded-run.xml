<!-- The determinism contract: <setup rngSeed> makes every generator, weighted pick
     and source shuffle replay identically across runs (and forces single-process).
     Drop rngSeed and every run differs — the privacy-maximized default.
     Ordered source reads keep row order stable; random reads shuffle identically
     under the same seed. -->
<setup rngSeed="42">
    <memstore id="mem"/>

    <generate name="accounts" count="15" target="mem,CSV" exportUri="recipe_out">
        <key name="account_id" generator="IncrementGenerator"/>
        <key name="iban" pattern="DE[0-9]{20}"/>
        <key name="balance" type="float" min="-500.0" max="10000.0"/>
        <key name="tier" values="'basic','premium'" weights="0.8,0.2"/>
    </generate>

    <!-- same seed => the same shuffled order on every run; disjoint page windows -->
    <iterate name="audit_sample" source="mem" type="accounts"
             distribution="random" count="5" target="JSON" exportUri="recipe_out"/>
</setup>
