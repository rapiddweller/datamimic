{
  "checks": [
    {"kind": "build_ready"},
    {"kind": "exact_count", "product": "offers", "n": 40},
    {"kind": "unique", "product": "offers", "field": "offer_id"},
    {"kind": "value_in", "product": "offers", "field": "tier", "values": ["BRONZE", "SILVER", "GOLD"]},
    {"kind": "range", "product": "offers", "field": "list_price", "min": 100, "max": 900},
    {"kind": "range", "product": "offers", "field": "sale_price", "min": 50, "max": 900},
    {"kind": "field_at_most", "product": "offers", "field": "sale_price", "other": "list_price"}
  ]
}
