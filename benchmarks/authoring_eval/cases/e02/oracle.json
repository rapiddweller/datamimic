{
  "checks": [
    {"kind": "build_ready"},
    {"kind": "exact_count", "product": "subscribers", "n": 5},
    {"kind": "exact_count", "product": "invoices", "n": 15},
    {"kind": "unique", "product": "subscribers", "field": "subscriber_id"},
    {"kind": "unique", "product": "invoices", "field": "invoice_id"},
    {"kind": "value_in", "product": "subscribers", "field": "plan", "values": ["BASIC", "PLUS", "PRO"]},
    {"kind": "value_in", "product": "invoices", "field": "state", "values": ["OPEN", "PAID", "VOID"]},
    {"kind": "range", "product": "invoices", "field": "amount_cents", "min": 500, "max": 20000},
    {
      "kind": "per_parent_count",
      "child": {"product": "invoices", "field": "subscriber_id"},
      "parent": {"product": "subscribers", "field": "subscriber_id"},
      "n": 3
    },
    {
      "kind": "fk_in_parent",
      "child": {"product": "invoices", "field": "subscriber_id"},
      "parent": {"product": "subscribers", "field": "subscriber_id"}
    }
  ]
}
