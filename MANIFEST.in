# Name the package data here: a tree without .git has no setuptools-scm file finder.
graft datamimic_ce

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so
global-exclude .git*
global-exclude .DS_Store

# Exclude all test directories and files
recursive-exclude * tests_ce

# Exclude specific test-related directories
prune tests_ce
prune test-artifacts
