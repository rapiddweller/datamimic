  "rules": [
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "datamimic_ce",
      "rationale": "Every product module has exactly one semantic owner.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Every component dependency is explicit; absence forbids the edge.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "NO-COMPONENT-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "The component graph must remain acyclic.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "INTERFACES-ONLY",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "Cross-component imports use the owning component's declared API.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "DSL-API-TYPES",
      "kind": "boundary_types",
      "source": "datamimic_ce.engine.dsl.api",
      "rationale": "The DSL facade exposes only builtins and declared DSL contract types.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "DOMAIN-API-TYPES",
      "kind": "boundary_types",
      "source": "datamimic_ce.domains.api",
      "rationale": "The domain facade exposes declared generator classes through a typed iterator, never an untyped registry dictionary.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RUNTIME-API-TYPES",
      "kind": "boundary_types",
      "source": "datamimic_ce.engine.runtime.api",
      "rationale": "Runtime requests and results are declared; Context and SetupContext remain public scripting types with separately reviewed dynamic state.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "IO-API-TYPES",
      "kind": "boundary_types",
      "source": "datamimic_ce.engine.io.api",
      "rationale": "The IO facade accepts declared IO requests instead of exposing mutable exporter internals.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "AUTHORING-API-TYPES",
      "kind": "boundary_types",
      "source": "datamimic_ce.authoring.api",
      "rationale": "The Authoring facade exposes typed application requests and results rather than implementation modules.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md",
        "docs/architecture/refactoring-study/experiment-2/amendment-11.md"
      ],
      "decided_by": "architect",
      "allowed_positions": [
        {
          "qualified_name": "datamimic_ce.authoring.api.run",
          "position": "return",
          "field_path": "products.sample",
          "annotation": "dict[str, JsonValue]"
        },
        {
          "qualified_name": "datamimic_ce.authoring.api.scaffold",
          "position": "return",
          "field_path": "issues.repair.corrected_fragment",
          "annotation": "dict[str, JsonValue]"
        },
        {
          "qualified_name": "datamimic_ce.authoring.api.scaffold",
          "position": "return",
          "field_path": "products.sample",
          "annotation": "dict[str, JsonValue]"
        },
        {
          "qualified_name": "datamimic_ce.authoring.api.scaffold",
          "position": "return",
          "field_path": "acceptance.results.observed_counts",
          "annotation": "dict[str, int] | None"
        }
      ]
    },
    {
      "id": "RESOURCES-API-TYPES",
      "kind": "boundary_types",
      "source": "datamimic_ce.resources.api",
      "rationale": "The resource facade exposes typed packaged-resource access rather than string-based package discovery.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "NO-MAGIC-CONTROL-FLOW",
      "kind": "forbidden_construct",
      "source": "datamimic_ce",
      "constructs": [
        "any_annotation",
        "cast",
        "delattr",
        "dunder_dict",
        "hasattr",
        "setattr",
        "type_ignore",
        "vars"
      ],
      "rationale": "Public behavior uses explicit types and avoids reflective escape hatches.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "NO-GETATTR-COMPATIBILITY-ADAPTERS",
      "kind": "forbidden_construct",
      "source": "datamimic_ce",
      "constructs": [
        "getattr"
      ],
      "exact_sources": [
        "datamimic_ce.domains.domain_core.base_entity.BaseEntity.__getattr__",
        "datamimic_ce.engine.runtime.scripting.expression_globals._EvalProxy.__getattr__",
        "datamimic_ce.engine.runtime.scripting.expression_globals._SeededFaker.__getattr__",
        "datamimic_ce.engine.runtime.tasks.values.variable.iterator.VariableIterator.__getattr__"
      ],
      "rationale": "Only these DSL/runtime compatibility adapters may forward dynamic attributes; every other getattr remains forbidden.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/amendment-10.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "DYNAMIC-EXECUTION-OWNERS",
      "kind": "forbidden_construct",
      "source": "datamimic_ce",
      "constructs": [
        "dynamic_import",
        "eval",
        "exec"
      ],
      "allowed_sources": [
        "datamimic_ce.engine.runtime.scripting.evaluation",
        "datamimic_ce.engine.runtime.scripting.plugins"
      ],
      "rationale": "Dynamic execution is isolated in scripting's expression and plugin owners.",
      "provenance": [
        "docs/architecture/refactoring-study/experiment-2/target-architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "NO-MODULE-CYCLES",
      "kind": "no_component_cycles",
      "level": "module",
      "rationale": "No production module cycles, including type-only imports; a green component graph is insufficient.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "PURE-INTENT-NO-RUNTIME",
      "kind": "forbidden_dependency",
      "source": "datamimic_ce.authoring.domain",
      "target": "datamimic_ce.engine.runtime",
      "include_type_checking": true,
      "rationale": "Intent and validation facts must remain runtime-free; bounded execution is an adapter concern.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "PURE-INTENT-NO-IO",
      "kind": "forbidden_dependency",
      "source": "datamimic_ce.authoring.domain",
      "target": "datamimic_ce.engine.io",
      "include_type_checking": true,
      "rationale": "Intent cannot open sources or construct clients.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "PROJECTION-NO-RUNTIME",
      "kind": "forbidden_dependency",
      "source": "datamimic_ce.authoring.projection",
      "target": "datamimic_ce.engine.runtime",
      "include_type_checking": true,
