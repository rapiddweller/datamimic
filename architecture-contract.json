        "datamimic_ce.authoring.contracts:RunResult",
        "datamimic_ce.authoring.contracts:ScaffoldRequest",
        "datamimic_ce.authoring.contracts:ScaffoldResult",
        "datamimic_ce.authoring.contracts:ScaffoldVerification",
