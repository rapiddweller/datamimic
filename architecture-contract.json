  "rules": [
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "datamimic_ce",
      "rationale": "A module without exactly one owning component escapes every boundary rule.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "rationale": "Responsibilities define the allowed imports: an edge nobody declared is an accident, so every new component edge is a visible contract change.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "Components meet only through their declared public names; the lists freeze today's surface and shrink toward facades.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-COMPLETE",
      "kind": "complete_external_scope",
      "source": "datamimic_ce",
      "rationale": "Every third-party library has declared owners, so a heavy dependency in the wrong layer is a visible contract change.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
