{
  "schema_version": "2.1.0",
  "components": [
    {
      "id": "COMP-INTERFACES",
      "label": "interfaces",
      "role": "interface",
      "packages": [
        "datamimic_ce.cli",
        "datamimic_ce.cli_authoring",
        "datamimic_ce.cli_presenter",
        "datamimic_ce.cli_runtime",
        "datamimic_ce.mcp",
        "datamimic_ce.datamimic",
        "datamimic_ce.data_mimic_test",
        "datamimic_ce.factory"
      ],
      "responsibilities": [
        "CLI, MCP server and Python API (datamimic, data_mimic_test)",
        "factory is the composition root that wires a run"
      ],
      "forbidden_responsibilities": [
        "business logic",
        "being imported by other components"
      ],
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "requires": [
        {
          "component": "authoring",
          "rationale": "Interfaces expose the authoring use cases."
        },
        {
          "component": "dsl",
          "rationale": "Interfaces read descriptors into the DSL."
        },
        {
          "component": "engine",
          "rationale": "Interfaces start runs; factory composes the engine."
        },
        {
          "component": "foundation",
          "rationale": "Interfaces use settings, logging and primitives."
        },
        {
          "component": "io",
          "rationale": "The composition root wires connections for a run."
        }
      ],
      "public": [
        "datamimic_ce.datamimic:DataMimic"
      ]
    },
    {
      "id": "COMP-AUTHORING",
      "label": "authoring",
      "role": "component",
      "packages": [
        "datamimic_ce.authoring"
      ],
      "responsibilities": [
        "model.dm.json intent to XML",
        "lint rules and rule catalog",
        "bounded dry-run and acceptance verification"
      ],
      "forbidden_responsibilities": [
        "importing interfaces"
      ],
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "requires": [
        {
          "component": "domain",
          "rationale": "Authoring projects the available domain entities."
        },
        {
          "component": "dsl",
          "rationale": "Authoring compiles intent into the DSL and checks it against its models."
        },
        {
          "component": "engine",
          "rationale": "Authoring runs bounded dry-runs as part of its verification use case."
        },
        {
          "component": "foundation",
          "rationale": "Authoring uses shared primitives."
        },
        {
          "component": "interfaces",
          "rationale": "Debt: authoring.dryrun starts a run through the DataMimic interface; target: call the engine directly."
        },
        {
          "component": "io",
          "rationale": "Authoring projects the available source and exporter kinds."
        }
      ],
      "public": [
        "datamimic_ce.authoring.contracts:AUTHORING_REFERENCE_QUERY_ADAPTER",
        "datamimic_ce.authoring.contracts:AuthoringReferenceCategory",
