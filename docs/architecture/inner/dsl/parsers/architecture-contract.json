  "rules": [
    {
      "id": "PARSERS-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "datamimic_ce.engine.dsl.parsers",
      "rationale": "Each parser implementation belongs to one semantic family.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "PARSERS-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Parser implementations depend on the base protocol; composition owns registry-to-implementation dependencies.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "PARSERS-NO-COMPONENT-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Parser family dependencies must remain acyclic.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "PARSERS-INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "The shared parser base and descriptor entry point are the declared interfaces.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
