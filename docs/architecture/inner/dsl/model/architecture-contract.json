  "rules": [
    {
      "id": "MODEL-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "datamimic_ce.engine.dsl.model",
      "rationale": "Each model and constraint implementation has one grammar owner.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "MODEL-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Model composition flows from constraints and model families to the registry; reverse parser dependencies are forbidden.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "MODEL-NO-COMPONENT-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Model ownership and registry composition must remain acyclic.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "MODEL-INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "Sibling families consume explicit model types; metadata consumers use canonical constraint and registry projections.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
