        "datamimic_ce.authoring.contracts",
        "datamimic_ce.authoring.spec",
        "datamimic_ce.authoring.domain"
      ],
      "responsibilities": [
        "Observable request/result contracts, intent specification, diagnostics, acceptance facts and pure rules; one domain aggregate without a DTO/rule component cycle."
      ],
      "forbidden_responsibilities": [
        "Import Runtime or IO",
        "Parse files or execute descriptors"
      ],
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "requires": [],
      "public": [
        "datamimic_ce.authoring.contracts",
        "datamimic_ce.authoring.spec",
        "datamimic_ce.authoring.domain.derived_facts:derive_facts",
        "datamimic_ce.authoring.domain.diagnostics",
        "datamimic_ce.authoring.domain.rule_catalog",
        "datamimic_ce.authoring.domain.rules.base",
        "datamimic_ce.authoring.domain.rules.best_practice",
        "datamimic_ce.authoring.domain.rules.cross_statement",
        "datamimic_ce.authoring.domain.rules.intent_rules",
        "datamimic_ce.authoring.domain.rules.schema_facts",
        "datamimic_ce.authoring.domain.rules.schema_rules",
        "datamimic_ce.authoring.domain.rules.semantic_rules",
        "datamimic_ce.authoring.domain.schema",
        "datamimic_ce.authoring.domain.script_semantics"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-PROJECTION",
      "label": "projection",
      "role": "projection",
      "packages": [
        "datamimic_ce.authoring.projection"
      ],
      "responsibilities": [
        "Render reference and schema views from canonical DSL/domain facts."
      ],
      "forbidden_responsibilities": [
        "Define a second DSL catalog or execute a run."
      ],
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "requires": [
        {
          "component": "domain",
          "rationale": "Projections render authoring-owned facts and types.",
          "decided_by": "agent"
        }
      ],
      "public": [
        "datamimic_ce.authoring.projection.reference",
        "datamimic_ce.authoring.projection.reference_projection"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-ADAPTERS",
      "label": "adapters",
      "role": "component",
      "packages": [
        "datamimic_ce.authoring.adapters"
      ],
      "responsibilities": [
        "Bounded runtime/filesystem execution adapters."
      ],
      "forbidden_responsibilities": [
        "Own intent or duplicate executable DSL definitions."
      ],
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "requires": [
        {
          "component": "domain",
          "rationale": "Adapters consume typed intent and diagnostics.",
          "decided_by": "agent"
        },
        {
          "component": "projection",
          "rationale": "Compiler and linter use derived DSL schema views.",
          "decided_by": "agent"
        }
      ],
      "public": [
        "datamimic_ce.authoring.adapters.dryrun",
        "datamimic_ce.authoring.adapters.engine_check",
        "datamimic_ce.authoring.adapters.linter",
        "datamimic_ce.authoring.adapters.xml_loader"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-APPLICATION",
      "label": "application",
      "role": "component",
      "packages": [
        "datamimic_ce.authoring.application"
      ],
      "responsibilities": [
        "Compile/check/run/scaffold transaction coordination."
      ],
      "forbidden_responsibilities": [
        "Define new grammar facts or directly execute Runtime internals."
      ],
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "requires": [
        {
          "component": "domain",
          "rationale": "Workflows operate on typed authoring requests and results.",
          "decided_by": "agent"
        },
        {
          "component": "projection",
          "rationale": "Validation uses canonical reference projections.",
          "decided_by": "agent"
        },
        {
          "component": "adapters",
          "rationale": "Workflows delegate compilation and bounded checks.",
          "decided_by": "agent"
        }
      ],
      "public": [
        "datamimic_ce.authoring.application.service"
      ],
      "decided_by": "agent"
    }
  ],
  "rules": [
    {
      "id": "AUTHORING-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Pure intent and rules must not depend on file or execution adapters.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "datamimic_ce.authoring",
      "rationale": "Every implementation below this boundary has one declared owner; initializer behavior is reviewed separately.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-INTERFACES",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "Sibling components use explicit entry points; a permitted direction does not publish all internals.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-ACYCLIC",
      "kind": "no_component_cycles",
      "rationale": "Responsibility layers must not require one another in both directions.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LAYOUT-AUTHORING-ADAPTERS",
      "kind": "root_layout",
      "root": "datamimic_ce.authoring.adapters",
      "allowed_children": [
        "datamimic_ce.authoring.adapters.dryrun",
        "datamimic_ce.authoring.adapters.engine_check",
        "datamimic_ce.authoring.adapters.linter",
        "datamimic_ce.authoring.adapters.xml_loader"
