{
  "schema_version": "2.1.0",
  "components": [
    {
      "id": "AUTHORING-API",
      "label": "api",
      "role": "interface",
      "packages": [
        "datamimic_ce.authoring.api"
      ],
      "responsibilities": [
        "Public use-case entry."
      ],
      "forbidden_responsibilities": [
        "Own compilation, verification, or transport behavior."
      ],
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "requires": [
        {
          "component": "domain",
          "rationale": "Public signatures use authoring-owned types.",
          "decided_by": "agent"
        },
        {
          "component": "application",
          "rationale": "The facade delegates authoring workflows.",
          "decided_by": "agent"
        }
      ],
      "public": [
        "datamimic_ce.authoring.api"
      ],
      "decided_by": "agent"
    },
    {
      "id": "AUTHORING-DOMAIN",
      "label": "domain",
