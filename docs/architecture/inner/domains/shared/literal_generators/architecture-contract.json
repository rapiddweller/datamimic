  "rules": [
    {
      "id": "LITERALS-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "datamimic_ce.domains.shared",
      "rationale": "Every built-in literal generator has one owner within the parent component scope; registry composition belongs to domains.registry.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LITERALS-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Generator-family reuse is explicit; generators cannot depend on registry assembly.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LITERALS-NO-COMPONENT-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Generator composition must remain acyclic.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LITERALS-INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "Generator classes are typed interfaces used by callers; registry composition belongs to domains.registry.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
