  "rules": [
    {
      "id": "TRANSPORT-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "datamimic_ce.interfaces",
      "rationale": "Every child implementation has one owner; parent initializer behavior is reviewed explicitly.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TRANSPORT-REQUIRES",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Only the listed responsibility directions are permitted.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TRANSPORT-INTERFACES",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "A dependency reaches explicit operations and types, not arbitrary implementation details.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TRANSPORT-ACYCLIC",
      "kind": "no_component_cycles",
      "rationale": "Lower layers do not import their consumers.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LAYOUT-INTERFACES-CLI",
      "kind": "root_layout",
      "root": "datamimic_ce.interfaces.cli",
      "allowed_children": [
        "datamimic_ce.interfaces.cli.__main__",
        "datamimic_ce.interfaces.cli.authoring",
        "datamimic_ce.interfaces.cli.presenter",
        "datamimic_ce.interfaces.cli.runtime"
      ],
      "rationale": "CLI request/response adaptation. Exact reviewed target children; no hidden extra modules.",
      "provenance": [
        "docs/architecture/inner/structure-review.json"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LAYOUT-INTERFACES-MCP",
      "kind": "root_layout",
      "root": "datamimic_ce.interfaces.mcp",
      "allowed_children": [
        "datamimic_ce.interfaces.mcp.cli",
        "datamimic_ce.interfaces.mcp.server"
      ],
      "rationale": "Optional MCP request/response adaptation. Exact reviewed target children; no hidden extra modules.",
      "provenance": [
        "docs/architecture/inner/structure-review.json"
      ],
      "decided_by": "agent"
    },
    {
      "id": "LAYOUT-INTERFACES-PYTHON",
