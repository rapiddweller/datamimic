      "decided_by": "agent"
    },
    {
      "id": "EXPORTERS-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Exporter families depend on shared lifecycle contracts; only registry composition depends on concrete families.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "EXPORTERS-NO-COMPONENT-CYCLES",
