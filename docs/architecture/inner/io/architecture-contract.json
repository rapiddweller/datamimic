  "rules": [
    {
      "id": "IO-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Connector code must not depend on source or exporter policy.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "IO-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "datamimic_ce.engine.io",
      "rationale": "Every implementation below this boundary has one declared owner; initializer behavior is reviewed separately.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "IO-INTERFACES",
      "kind": "interface_boundary",
      "include_type_checking": true,
      "rationale": "Sibling components use explicit entry points; a permitted direction does not publish all internals.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "IO-ACYCLIC",
      "kind": "no_component_cycles",
      "rationale": "Responsibility layers must not require one another in both directions.",
      "provenance": [
        "docs/architecture/inner/target.md"
      ],
      "decided_by": "agent"
    },
